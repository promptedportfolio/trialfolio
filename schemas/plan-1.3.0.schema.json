{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.experiment_plan.PlanV1_3, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "DataSentV1_2": {
      "additionalProperties": false,
      "description": "A category of data that leaves the machine, in a plan with a ranking definition.",
      "properties": {
        "category": {
          "enum": [
            "credentials",
            "strategy_definition",
            "backtest_settings"
          ],
          "title": "Category",
          "type": "string"
        },
        "recipient": {
          "const": "Portfolio123",
          "title": "Recipient",
          "type": "string"
        },
        "via": {
          "const": "p123api",
          "title": "Via",
          "type": "string"
        },
        "settings": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "recipient",
        "via",
        "settings"
      ],
      "title": "DataSentV1_2",
      "type": "object"
    },
    "DeclaredPriorResearch": {
      "additionalProperties": false,
      "description": "The prior-research declaration as the configuration gives it, with `user_supplied`\nprovenance. Trial Folio can't verify it.",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Given with `complete` or `partial`, and optionally with `unknown`; null when it isn't.",
          "title": "Description"
        }
      },
      "required": [
        "status",
        "description"
      ],
      "title": "DeclaredPriorResearch",
      "type": "object"
    },
    "DefinitionRankingSetting": {
      "additionalProperties": false,
      "description": "A ranking given as a definition, in a file or by a snapshot, as a case's resolved\n`ranking` holds it: the definition's hash and its ranking method, in place of the\nconfiguration's keys. So the `case_id` covers the definition, byte for byte, and its ranking\nmethod, and nothing about where it came from (ranking definitions).",
      "properties": {
        "definition": {
          "description": "`sha256:` and the hex SHA-256 of the definition's UTF-8 text.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition",
          "type": "string"
        },
        "ranking_method": {
          "enum": [
            "percentile_nas_negative",
            "percentile_nas_neutral"
          ],
          "title": "Ranking Method",
          "type": "string"
        }
      },
      "required": [
        "definition",
        "ranking_method"
      ],
      "title": "DefinitionRankingSetting",
      "type": "object"
    },
    "DocumentedSource": {
      "additionalProperties": false,
      "description": "Where a documented value comes from, and the date the documentation was checked.",
      "properties": {
        "title": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "checked"
      ],
      "title": "DocumentedSource",
      "type": "object"
    },
    "ExperimentPlanCaseV1_3": {
      "additionalProperties": false,
      "description": "One case of an experiment whose ranking is a definition: a 1.1.0 case, with plan 1.2.0's\ntwo requests, and its settings with a weight row for each node.",
      "properties": {
        "case_key": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Key",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The variant's description, with `user_supplied` provenance; null when there's none, and\nfor the baseline.",
          "title": "Description"
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanVariantV1_3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for the baseline."
        },
        "requests": {
          "description": "The `rank_update` that writes the case's whole definition, then its backtest.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RankUpdateRequest"
            },
            {
              "$ref": "#/$defs/PlanRequest"
            }
          ],
          "title": "Requests",
          "type": "array"
        },
        "settings": {
          "items": {
            "$ref": "#/$defs/PlanSettingV1_2"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "case_key",
        "case_id",
        "description",
        "variant",
        "requests",
        "settings"
      ],
      "title": "ExperimentPlanCaseV1_3",
      "type": "object"
    },
    "FormulaRankingParams": {
      "additionalProperties": false,
      "description": "A single-formula ranking, as sent.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        },
        "lowerIsBetter": {
          "title": "Lowerisbetter",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "lowerIsBetter"
      ],
      "title": "FormulaRankingParams",
      "type": "object"
    },
    "OperationCost": {
      "additionalProperties": false,
      "description": "One operation's documented cost, in credits, when the plan was made, and its source.",
      "properties": {
        "operation": {
          "enum": [
            "rank_update",
            "screen_backtest"
          ],
          "title": "Operation",
          "type": "string"
        },
        "credits_per_request": {
          "minimum": 0,
          "title": "Credits Per Request",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/DocumentedSource"
        }
      },
      "required": [
        "operation",
        "credits_per_request",
        "source"
      ],
      "title": "OperationCost",
      "type": "object"
    },
    "PlanBudgetV1_3": {
      "additionalProperties": false,
      "description": "The budget across runs of an experiment whose ranking is a definition: 1.1.0's, with each\noperation's documented cost in place of the one cost a request had.",
      "properties": {
        "provider_requests": {
          "description": "The configuration's `budget.provider_requests`.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Provider Requests",
          "type": "integer"
        },
        "costs": {
          "description": "`rank_update`'s documented cost, then the backtest's.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/OperationCost"
            },
            {
              "$ref": "#/$defs/OperationCost"
            }
          ],
          "title": "Costs",
          "type": "array"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "integer"
        },
        "authentication_calls": {
          "description": "Equal to `provider_requests`.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Authentication Calls",
          "type": "integer"
        }
      },
      "required": [
        "provider_requests",
        "costs",
        "credits",
        "authentication_calls"
      ],
      "title": "PlanBudgetV1_3",
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "description": "One provider request a case needs.",
      "properties": {
        "operation": {
          "const": "screen_backtest",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ScreenBacktestParams"
        }
      },
      "required": [
        "operation",
        "params"
      ],
      "title": "PlanRequest",
      "type": "object"
    },
    "PlanSettingV1_2": {
      "additionalProperties": false,
      "description": "One resolved setting of a plan with a ranking definition: 1.0.0's row, with `node` after\n`setting`: a weight row's canonical path, and null on every other row.",
      "properties": {
        "setting": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Setting",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A weight row's node, by its canonical path; null on every other row.",
          "title": "Node"
        },
        "category": {
          "enum": [
            "dates",
            "benchmark",
            "currency",
            "costs",
            "execution",
            "universe",
            "data_source",
            "strategy",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/SettingValueV1_2"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "count",
                "weeks",
                "percent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "interpretation": {
          "enum": [
            "interpreted",
            "not_interpreted"
          ],
          "title": "Interpretation",
          "type": "string"
        },
        "expected_provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Expected Provenance",
          "type": "string"
        },
        "inference_rule": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inference Rule"
        },
        "flags": {
          "items": {
            "enum": [
              "inferred_default",
              "not_snapshotted"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "setting",
        "node",
        "category",
        "critical",
        "value",
        "unit",
        "interpretation",
        "expected_provenance",
        "inference_rule",
        "flags"
      ],
      "title": "PlanSettingV1_2",
      "type": "object"
    },
    "PlanVariantV1_3": {
      "additionalProperties": false,
      "description": "A case's variant in plan 1.3.0: 1.1.0's, with a ranking variant's change, `set` and\n`remove`. Each key is always written, null where it doesn't apply.",
      "properties": {
        "setting": {
          "enum": [
            "rules",
            "ranking",
            "max_holdings",
            "rebalance_weeks",
            "slippage_percent"
          ],
          "title": "Setting",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "add": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Add"
        },
        "replace": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replace"
        },
        "with": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "With"
        },
        "set": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WeightChange"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "A ranking variant's weights, for each entry of the configuration's `set`, each node by\nits canonical path, in the baseline definition's order; null in a variant of another\nsetting.",
          "title": "Set"
        },
        "remove": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The canonical path of the factor a ranking variant removes; null when it removes none,\nand in a variant of another setting.",
          "title": "Remove"
        },
        "default": {
          "type": "boolean",
          "description": "True for P-13's default rebalance variant, and false otherwise.",
          "title": "Default"
        }
      },
      "required": [
        "setting",
        "value",
        "add",
        "replace",
        "with",
        "set",
        "remove",
        "default"
      ],
      "title": "PlanVariantV1_3",
      "type": "object"
    },
    "RankUpdateParams": {
      "additionalProperties": false,
      "description": "The params passed to p123api's `rank_update`, exactly as they're sent, in this order: the\nfixed type, the case's whole definition, its ranking method's number, and the fixed currency.\nThere's no `id`, so the call writes `ApiRankingSystem` (sending a definition).",
      "properties": {
        "type": {
          "const": "stock",
          "title": "Type",
          "type": "string"
        },
        "nodes": {
          "description": "The case's whole definition, as its file's text reads, each line end a line feed.",
          "minLength": 1,
          "title": "Nodes",
          "type": "string"
        },
        "rankingMethod": {
          "description": "2 for `percentile_nas_negative`, and 4 for `percentile_nas_neutral`.",
          "enum": [
            2,
            4
          ],
          "title": "Rankingmethod",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "type",
        "nodes",
        "rankingMethod",
        "currency"
      ],
      "title": "RankUpdateParams",
      "type": "object"
    },
    "RankUpdateRequest": {
      "additionalProperties": false,
      "description": "A case's first request: the `rank_update` that writes its definition into\n`ApiRankingSystem`.",
      "properties": {
        "operation": {
          "const": "rank_update",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RankUpdateParams"
        }
      },
      "required": [
        "operation",
        "params"
      ],
      "title": "RankUpdateRequest",
      "type": "object"
    },
    "RankingSource": {
      "additionalProperties": false,
      "description": "Where the plan's ranking definition came from, which the plan hash covers and no `case_id`\ndoes: a file, by the definition's hash, or a snapshot, by its system's name and the\n`artifact_id`s of its `snapshot.json` and `definition.xml` (ranking definitions). Each field\nis always written, null where the form has none.",
      "properties": {
        "form": {
          "enum": [
            "definition",
            "snapshot"
          ],
          "title": "Form",
          "type": "string"
        },
        "definition": {
          "description": "The definition's hash, which the baseline's `ranking` setting holds too.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A snapshot's system's name, as its record gives it in `system.name`; null for a file.",
          "title": "System"
        },
        "snapshot_record": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `artifact_id` of a snapshot's `snapshot.json`; null for a file.",
          "title": "Snapshot Record"
        },
        "snapshot_definition": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `artifact_id` of a snapshot's `definition.xml`; null for a file.",
          "title": "Snapshot Definition"
        }
      },
      "required": [
        "form",
        "definition",
        "system",
        "snapshot_record",
        "snapshot_definition"
      ],
      "title": "RankingSource",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "The retry policy: no automatic retries, and one exchange per wrapper call.",
      "properties": {
        "automatic_retries": {
          "const": 0,
          "title": "Automatic Retries",
          "type": "integer"
        },
        "wrapper_attempts_per_call": {
          "const": 1,
          "title": "Wrapper Attempts Per Call",
          "type": "integer"
        },
        "exchanges_per_call": {
          "const": 1,
          "title": "Exchanges Per Call",
          "type": "integer"
        }
      },
      "required": [
        "automatic_retries",
        "wrapper_attempts_per_call",
        "exchanges_per_call"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "ScreenBacktestParams": {
      "additionalProperties": false,
      "description": "The JSON object passed to p123api's `screen_backtest`, exactly as it will be sent.\n\n`slippage` is always a JSON float, and every other number an integer (plan contents).",
      "properties": {
        "screen": {
          "$ref": "#/$defs/ScreenParams"
        },
        "startDt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Startdt",
          "type": "string"
        },
        "endDt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Enddt",
          "type": "string"
        },
        "pitMethod": {
          "const": "Complete",
          "title": "Pitmethod",
          "type": "string"
        },
        "precision": {
          "const": 4,
          "title": "Precision",
          "type": "integer"
        },
        "transPrice": {
          "const": 1,
          "title": "Transprice",
          "type": "integer"
        },
        "slippage": {
          "title": "Slippage",
          "type": "number"
        },
        "rebalFreq": {
          "enum": [
            "Every Week",
            "Every 4 Weeks"
          ],
          "title": "Rebalfreq",
          "type": "string"
        }
      },
      "required": [
        "screen",
        "startDt",
        "endDt",
        "pitMethod",
        "precision",
        "transPrice",
        "slippage",
        "rebalFreq"
      ],
      "title": "ScreenBacktestParams",
      "type": "object"
    },
    "ScreenParams": {
      "additionalProperties": false,
      "description": "The `screen` object of a screen backtest request.",
      "properties": {
        "type": {
          "const": "stock",
          "title": "Type",
          "type": "string"
        },
        "universe": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Universe",
          "type": "string"
        },
        "maxNumHoldings": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Maxnumholdings",
          "type": "integer"
        },
        "method": {
          "const": "long",
          "title": "Method",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "benchmark": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Benchmark",
          "type": "string"
        },
        "ranking": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaRankingParams"
            },
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "title": "Ranking"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ScreenRuleParams"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "type",
        "universe",
        "maxNumHoldings",
        "method",
        "currency",
        "benchmark",
        "ranking",
        "rules"
      ],
      "title": "ScreenParams",
      "type": "object"
    },
    "ScreenRuleParams": {
      "additionalProperties": false,
      "description": "One screening rule, as sent. It has no `type` field: Portfolio123 rejects one.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        }
      },
      "required": [
        "formula"
      ],
      "title": "ScreenRuleParams",
      "type": "object"
    },
    "SettingValueV1_2": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "items": {
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/DefinitionRankingSetting"
        }
      ]
    },
    "TransportVersions": {
      "additionalProperties": false,
      "description": "The installed `requests` and `urllib3`, which carry the wrapper's requests.",
      "properties": {
        "requests": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Requests",
          "type": "string"
        },
        "urllib3": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Urllib3",
          "type": "string"
        }
      },
      "required": [
        "requests",
        "urllib3"
      ],
      "title": "TransportVersions",
      "type": "object"
    },
    "WeightChange": {
      "additionalProperties": false,
      "description": "One entry of a ranking variant's `set`: a node, by its canonical path in the baseline's\ndefinition, and the weight the variant gives it.",
      "properties": {
        "node": {
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "weight": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "node",
        "weight"
      ],
      "title": "WeightChange",
      "type": "object"
    },
    "WrapperVersions": {
      "additionalProperties": false,
      "description": "The installed `p123api`, which sends the requests (plan contents).",
      "properties": {
        "p123api": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "P123Api",
          "type": "string"
        }
      },
      "required": [
        "p123api"
      ],
      "title": "WrapperVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An experiment's plan whose ranking is a definition: plan 1.1.0's, with each case's\n`rank_update` and its whole definition, the weight rows, the definition's source, and each\noperation's cost. Execution requires its `plan_hash` as approval (plans with a ranking\ndefinition).",
  "properties": {
    "schema_version": {
      "const": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "canonicalization_version": {
      "const": 1,
      "title": "Canonicalization Version",
      "type": "integer"
    },
    "provider_wrapper": {
      "$ref": "#/$defs/WrapperVersions"
    },
    "transport": {
      "$ref": "#/$defs/TransportVersions"
    },
    "experiment_id": {
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "description": "An experiment's purpose is required, so it's never null.",
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Purpose",
      "type": "string"
    },
    "prior_research": {
      "$ref": "#/$defs/DeclaredPriorResearch"
    },
    "ranking_source": {
      "$ref": "#/$defs/RankingSource",
      "description": "The baseline's definition's source: every case's definition is the baseline's, or a\nranking variant's change of it."
    },
    "revises": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The `plan_hash` of the plan this one revises; null for the experiment's first plan.",
      "title": "Revises"
    },
    "cases": {
      "description": "Every case, in the order of cases: the baseline first, then the variants of `rules`,\n`ranking`, `max_holdings`, `rebalance_weeks`, and `slippage_percent`.",
      "items": {
        "$ref": "#/$defs/ExperimentPlanCaseV1_3"
      },
      "minItems": 2,
      "title": "Cases",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/PlanBudgetV1_3"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "data_sent": {
      "items": {
        "$ref": "#/$defs/DataSentV1_2"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Data Sent",
      "type": "array"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trialfolio_version",
    "canonicalization_version",
    "provider_wrapper",
    "transport",
    "experiment_id",
    "title",
    "purpose",
    "prior_research",
    "ranking_source",
    "revises",
    "cases",
    "budget",
    "retry_policy",
    "data_sent",
    "plan_hash"
  ],
  "title": "PlanV1_3",
  "type": "object"
}
