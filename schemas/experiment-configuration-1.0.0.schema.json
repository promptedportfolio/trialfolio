{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.experiment_configuration.ExperimentConfiguration, in validation mode. In serialization mode, the schema differs. Never edit it by hand.",
  "$defs": {
    "ExperimentBudget": {
      "additionalProperties": false,
      "description": "The experiment's request budget, across every `run` that resumes it.",
      "properties": {
        "provider_requests": {
          "description": "The most provider requests the experiment may send: at least the number of cases.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Provider Requests",
          "type": "integer"
        }
      },
      "required": [
        "provider_requests"
      ],
      "title": "ExperimentBudget",
      "type": "object"
    },
    "FormulaRanking": {
      "additionalProperties": false,
      "description": "A ranking by a single formula, the recommended form.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        },
        "lower_is_better": {
          "title": "Lower Is Better",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "lower_is_better"
      ],
      "title": "FormulaRanking",
      "type": "object"
    },
    "HoldingsVariant": {
      "additionalProperties": false,
      "description": "A variant of the maximum holdings.",
      "properties": {
        "key": {
          "description": "The case's `case_key`: unique among the experiment's cases, the default's included, and\nnot `baseline`.",
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "description": {
          "description": "Up to 500 characters, shown in the report.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Description",
          "type": "string"
        },
        "value": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "HoldingsVariant",
      "type": "object"
    },
    "IdRanking": {
      "additionalProperties": false,
      "description": "An existing ranking system in the account, by ID. It's recorded as not snapshotted.",
      "properties": {
        "id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "IdRanking",
      "type": "object"
    },
    "NameRanking": {
      "additionalProperties": false,
      "description": "An existing ranking system in the account, by name. It's recorded as not snapshotted.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "NameRanking",
      "type": "object"
    },
    "PriorResearch": {
      "additionalProperties": false,
      "description": "The prior-research declaration: earlier work on the same idea whose outcomes the user saw,\nin Trial Folio or anywhere else. Trial Folio can't verify it, and records it as written.",
      "properties": {
        "status": {
          "description": "`complete`: the description accounts for all of it, or says there was none. `partial`:\nfor some of it. `unknown`: the user can't say what earlier work there was.",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "description": "Required with `complete` or `partial`: 1 to 5,000 characters.",
          "maxLength": 5000,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PriorResearch",
      "type": "object"
    },
    "Ranking": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormulaRanking"
        },
        {
          "$ref": "#/$defs/NameRanking"
        },
        {
          "$ref": "#/$defs/IdRanking"
        }
      ]
    },
    "RebalanceVariant": {
      "additionalProperties": false,
      "description": "A variant of the rebalance frequency.",
      "properties": {
        "key": {
          "description": "The case's `case_key`: unique among the experiment's cases, the default's included, and\nnot `baseline`.",
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "description": {
          "description": "Up to 500 characters, shown in the report.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Description",
          "type": "string"
        },
        "value": {
          "enum": [
            1,
            4
          ],
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "RebalanceVariant",
      "type": "object"
    },
    "RuleVariant": {
      "additionalProperties": false,
      "description": "A variant of the rules: one of the baseline's rules replaced, with `replace` and `with`,\nor a rule added, with `add`.",
      "properties": {
        "key": {
          "description": "The case's `case_key`: unique among the experiment's cases, the default's included, and\nnot `baseline`.",
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "description": {
          "description": "Up to 500 characters, shown in the report.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Description",
          "type": "string"
        },
        "add": {
          "description": "A screening formula, added after the baseline's rules.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Add",
          "type": "string"
        },
        "replace": {
          "description": "One of the baseline's rules, the same text, character for character.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Replace",
          "type": "string"
        },
        "with": {
          "description": "The formula that takes `replace`'s place, so the rules keep their order.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "With",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "RuleVariant",
      "type": "object"
    },
    "ScreenFields": {
      "additionalProperties": false,
      "description": "A screen's settings: a screen configuration's keys from `universe` to `data_vendor`, with\ntheir types, rules, and verified values. An experiment's baseline is one (docs/contracts.md,\nthe baseline).",
      "properties": {
        "universe": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Universe",
          "type": "string"
        },
        "rules": {
          "items": {
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "ranking": {
          "$ref": "#/$defs/Ranking"
        },
        "max_holdings": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Max Holdings",
          "type": "integer"
        },
        "benchmark": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Benchmark",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "rebalance_weeks": {
          "enum": [
            1,
            4
          ],
          "title": "Rebalance Weeks",
          "type": "integer"
        },
        "transaction_price": {
          "const": "open",
          "title": "Transaction Price",
          "type": "string"
        },
        "slippage_percent": {
          "description": "Plain notation, with at most 4 digits after the decimal point and 15 significant digits. Never a string.",
          "exclusiveMaximum": 10000000000000000,
          "minimum": 0,
          "title": "Slippage Percent",
          "type": "number"
        },
        "pit_method": {
          "const": "complete",
          "title": "Pit Method",
          "type": "string"
        },
        "precision": {
          "const": 4,
          "title": "Precision",
          "type": "integer"
        },
        "data_vendor": {
          "const": "FactSet",
          "title": "Data Vendor",
          "type": "string"
        }
      },
      "required": [
        "universe",
        "rules",
        "ranking",
        "max_holdings",
        "benchmark",
        "start_date",
        "end_date",
        "rebalance_weeks",
        "transaction_price",
        "slippage_percent",
        "pit_method",
        "precision"
      ],
      "title": "ScreenFields",
      "type": "object"
    },
    "SlippageVariant": {
      "additionalProperties": false,
      "description": "A variant of the slippage, in percent: a decimal, read and normalized by the decimals\nrules.",
      "properties": {
        "key": {
          "description": "The case's `case_key`: unique among the experiment's cases, the default's included, and\nnot `baseline`.",
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "description": {
          "description": "Up to 500 characters, shown in the report.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Description",
          "type": "string"
        },
        "value": {
          "description": "Plain notation, with at most 4 digits after the decimal point and 15 significant digits. Never a string.",
          "exclusiveMaximum": 10000000000000000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "SlippageVariant",
      "type": "object"
    },
    "Variants": {
      "additionalProperties": false,
      "description": "The variants, by the setting each one changes, in lists whose order is kept. Each list\nholds at least one variant, except `rebalance_weeks`'s, where an empty list turns the default\nvariant off.",
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/RuleVariant"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "max_holdings": {
          "items": {
            "$ref": "#/$defs/HoldingsVariant"
          },
          "minItems": 1,
          "title": "Max Holdings",
          "type": "array"
        },
        "rebalance_weeks": {
          "description": "Replaces the default rebalance variant. An empty list turns it off.",
          "items": {
            "$ref": "#/$defs/RebalanceVariant"
          },
          "title": "Rebalance Weeks",
          "type": "array"
        },
        "slippage_percent": {
          "items": {
            "$ref": "#/$defs/SlippageVariant"
          },
          "minItems": 1,
          "title": "Slippage Percent",
          "type": "array"
        }
      },
      "title": "Variants",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An experiment configuration, `kind: experiment`: one baseline screen and a small set of\nvariants, each changing one setting of the baseline (docs/contracts.md, experiment\nconfiguration).",
  "properties": {
    "kind": {
      "const": "experiment",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment_id": {
      "description": "The experiment's identity.",
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "description": "The question the experiment addresses. Required: it's part of the research history.",
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Purpose",
      "type": "string"
    },
    "prior_research": {
      "$ref": "#/$defs/PriorResearch"
    },
    "baseline": {
      "$ref": "#/$defs/ScreenFields"
    },
    "variants": {
      "$ref": "#/$defs/Variants",
      "description": "When it's absent, the only variant is the default."
    },
    "budget": {
      "$ref": "#/$defs/ExperimentBudget"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "experiment_id",
    "title",
    "purpose",
    "prior_research",
    "baseline",
    "budget"
  ],
  "title": "ExperimentConfiguration",
  "type": "object"
}
