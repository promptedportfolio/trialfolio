{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.tables.MetricsRow, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "additionalProperties": false,
  "description": "One row of `metrics.csv`: one metric of one result.",
  "properties": {
    "label": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Label",
      "type": "string"
    },
    "subject": {
      "enum": [
        "strategy",
        "benchmark"
      ],
      "title": "Subject",
      "type": "string"
    },
    "metric_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Metric Id",
      "type": "string"
    },
    "source_label": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Label"
    },
    "value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A decimal with exactly its source's digits, or a date. Null when unavailable.",
      "title": "Value"
    },
    "unit": {
      "pattern": "^(percent|ratio|count|days|date|currency:[A-Z]{3})$",
      "title": "Unit",
      "type": "string"
    },
    "source_decimals": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "The digits after the decimal point, as reported. Null for dates, counts, and unavailable\nvalues.",
      "title": "Source Decimals"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "enum": [
            "absent_from_layout",
            "blank_in_source",
            "unparseable_in_source",
            "not_applicable",
            "not_supported",
            "input_unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    },
    "origin": {
      "enum": [
        "reported",
        "calculated"
      ],
      "title": "Origin",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "verified",
        "user_supplied",
        "inferred",
        "unknown"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Period Start"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Period End"
    },
    "benchmark": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Benchmark"
    },
    "source_artifact": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Artifact",
      "type": "string"
    },
    "source_location": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The value's JSON path in the response. Null for calculated values.",
      "title": "Source Location"
    }
  },
  "required": [
    "label",
    "subject",
    "metric_id",
    "source_label",
    "value",
    "unit",
    "source_decimals",
    "availability",
    "unavailable_reason",
    "origin",
    "provenance",
    "period_start",
    "period_end",
    "benchmark",
    "source_artifact",
    "source_location"
  ],
  "title": "MetricsRow",
  "type": "object"
}
