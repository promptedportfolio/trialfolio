{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.tables.AnalysisRow, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "additionalProperties": false,
  "description": "One row of `analysis.csv`: one value of the analysis set for a result, calculated from its\n`series.csv`, settings, `metrics.csv`, and its plan's period splits (analysis.csv).",
  "properties": {
    "label": {
      "description": "The case's `case_id`, as in `series.csv`.",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Label",
      "type": "string"
    },
    "analysis_set": {
      "description": "The analysis set's version, `1.0.0`, independent of the table's schema version.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Analysis Set",
      "type": "string"
    },
    "segment": {
      "pattern": "^(full|split-([0-9]|10))$",
      "title": "Segment",
      "type": "string"
    },
    "analysis": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Analysis",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "enum": [
            "strategy",
            "benchmark",
            "excess"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null on a value about the segment or the windows rather than a series.",
      "title": "Subject"
    },
    "window_days": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "A rolling return's window length, in calendar days. Null otherwise.",
      "title": "Window Days"
    },
    "value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A decimal with exactly `decimals` digits after its point, a whole number, or a date. A\ndecimal that rounds to zero is written without a sign. Null when unavailable.",
      "title": "Value"
    },
    "unit": {
      "enum": [
        "percent",
        "pp",
        "ratio",
        "count",
        "days",
        "date"
      ],
      "title": "Unit",
      "type": "string"
    },
    "decimals": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "The result's `precision` for `percent`, `pp`, and `ratio`, and 0 for `count` and `days`.\nNull for a date, and when unavailable.",
      "title": "Decimals"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "enum": [
            "input_unavailable",
            "not_applicable",
            "too_few_observations",
            "too_short",
            "outside_coverage",
            "not_recovered"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    },
    "observations": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "The observations behind the value, or, with too few, the number there were. Null when an\ninput is unavailable, and on `coverage_share`.",
      "title": "Observations"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Period Start"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The dates the value covers, as the analysis set gives them. Null when unavailable, and\nwhere the analysis set gives none.",
      "title": "Period End"
    },
    "reported_value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "On a reconciled value, the metric's `value` in `metrics.csv`, as written there. Null\notherwise, and when that metric is unavailable.",
      "title": "Reported Value"
    },
    "reconciliation": {
      "anyOf": [
        {
          "enum": [
            "agrees",
            "differs",
            "not_compared"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "On a reconciled value; null on every other.",
      "title": "Reconciliation"
    },
    "flags": {
      "items": {
        "enum": [
          "descriptive",
          "overlapping_windows",
          "not_recovered"
        ],
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "inputs": {
      "description": "The series it's calculated from.",
      "items": {
        "enum": [
          "daily",
          "period",
          "daily/strategy",
          "daily/benchmark",
          "period/strategy",
          "period/benchmark",
          "period/excess"
        ],
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "origin": {
      "const": "calculated",
      "title": "Origin",
      "type": "string"
    },
    "provenance": {
      "const": "inferred",
      "title": "Provenance",
      "type": "string"
    },
    "trialfolio_version": {
      "description": "The version that calculated it.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "source_artifact": {
      "description": "The `artifact_id` of the saved response its series came from.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Artifact",
      "type": "string"
    }
  },
  "required": [
    "label",
    "analysis_set",
    "segment",
    "analysis",
    "subject",
    "window_days",
    "value",
    "unit",
    "decimals",
    "availability",
    "unavailable_reason",
    "observations",
    "period_start",
    "period_end",
    "reported_value",
    "reconciliation",
    "flags",
    "inputs",
    "origin",
    "provenance",
    "trialfolio_version",
    "source_artifact"
  ],
  "title": "AnalysisRow",
  "type": "object"
}
