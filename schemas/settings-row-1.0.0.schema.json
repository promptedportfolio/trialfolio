{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.tables.SettingsRow, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "additionalProperties": false,
  "description": "One row of `settings.csv`: one setting of one result.",
  "properties": {
    "label": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Label",
      "type": "string"
    },
    "setting": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Setting",
      "type": "string"
    },
    "category": {
      "enum": [
        "dates",
        "benchmark",
        "currency",
        "costs",
        "execution",
        "universe",
        "data_source",
        "strategy",
        "other"
      ],
      "title": "Category",
      "type": "string"
    },
    "critical": {
      "title": "Critical",
      "type": "boolean"
    },
    "value": {
      "description": "The normalized value, as text: lists and mappings as JSON, and `not_sent` or\n`not_modeled` when the request gives none. Never empty.",
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Value",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "enum": [
            "count",
            "weeks",
            "percent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "interpretation": {
      "enum": [
        "interpreted",
        "not_interpreted"
      ],
      "title": "Interpretation",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "verified",
        "user_supplied",
        "inferred",
        "unknown"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "inference_rule": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inference Rule"
    },
    "original_key": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Original Key"
    },
    "original_value": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The value exactly as written in the configuration; null when absent.",
      "title": "Original Value"
    },
    "source_artifact": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Artifact",
      "type": "string"
    },
    "flags": {
      "items": {
        "enum": [
          "critical_unexplained_mismatch",
          "critical_unknown",
          "intended_change_not_observed",
          "inferred_default",
          "time_dependent_default",
          "unsupported_value",
          "not_snapshotted",
          "coverage_mismatch",
          "identical_source"
        ],
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    }
  },
  "required": [
    "label",
    "setting",
    "category",
    "critical",
    "value",
    "unit",
    "interpretation",
    "provenance",
    "inference_rule",
    "original_key",
    "original_value",
    "source_artifact",
    "flags"
  ],
  "title": "SettingsRow",
  "type": "object"
}
