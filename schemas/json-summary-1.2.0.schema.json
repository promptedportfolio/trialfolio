{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.summary.JsonSummaryV1_2, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "An error, as a stable code and an actionable message (errors).",
      "properties": {
        "code": {
          "enum": [
            "config.invalid",
            "input.not_found",
            "input.not_a_run",
            "artifact.unknown_schema_version",
            "environment.unsupported",
            "license.not_acknowledged",
            "plan.approval_required",
            "plan.changed",
            "output.not_empty",
            "storage.write_failed",
            "experiment.locked",
            "provider.auth_failed",
            "provider.unavailable",
            "provider.quota_exceeded",
            "provider.unsupported_capability",
            "provider.request_rejected",
            "provider.response_invalid",
            "provider.outcome_unknown",
            "execution.partial",
            "command.interrupted",
            "internal.unexpected"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExperimentCounts": {
      "additionalProperties": false,
      "description": "An experiment's counts, as its manifest counts them, across every run of it; and the\n`unavailable` rows of the planned cases' tables, and the warnings this command logged.",
      "properties": {
        "cases_planned": {
          "minimum": 2,
          "title": "Cases Planned",
          "type": "integer"
        },
        "cases_succeeded": {
          "minimum": 0,
          "title": "Cases Succeeded",
          "type": "integer"
        },
        "cases_failed": {
          "minimum": 0,
          "title": "Cases Failed",
          "type": "integer"
        },
        "cases_skipped": {
          "minimum": 0,
          "title": "Cases Skipped",
          "type": "integer"
        },
        "cases_unknown": {
          "minimum": 0,
          "title": "Cases Unknown",
          "type": "integer"
        },
        "cases_not_yet_run": {
          "minimum": 0,
          "title": "Cases Not Yet Run",
          "type": "integer"
        },
        "cases_retired": {
          "minimum": 0,
          "title": "Cases Retired",
          "type": "integer"
        },
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "repeats": {
          "minimum": 0,
          "title": "Repeats",
          "type": "integer"
        },
        "provider_requests": {
          "description": "The sends that may have reached Portfolio123, a `running` attempt counted as one, never\nauthentication.",
          "minimum": 0,
          "title": "Provider Requests",
          "type": "integer"
        },
        "authentication_calls": {
          "description": "Trial Folio's own authentication calls, whatever their result.",
          "minimum": 0,
          "title": "Authentication Calls",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The credits Portfolio123 reported charging; null when it reported none.",
          "title": "Cost"
        },
        "metrics_unavailable": {
          "minimum": 0,
          "title": "Metrics Unavailable",
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "cases_planned",
        "cases_succeeded",
        "cases_failed",
        "cases_skipped",
        "cases_unknown",
        "cases_not_yet_run",
        "cases_retired",
        "attempts",
        "repeats",
        "provider_requests",
        "authentication_calls",
        "cost",
        "metrics_unavailable",
        "warnings"
      ],
      "title": "ExperimentCounts",
      "type": "object"
    },
    "NoCounts": {
      "additionalProperties": false,
      "description": "The counts of a command that has none: `init`, `report`, and `license`.",
      "properties": {},
      "title": "NoCounts",
      "type": "object"
    },
    "ReviewCounts": {
      "additionalProperties": false,
      "description": "The counts of `review`. They're 0, or the number of results a valid configuration names,\nuntil `differences.csv` is written.",
      "properties": {
        "results": {
          "description": "The results compared, the baseline included.",
          "minimum": 0,
          "title": "Results",
          "type": "integer"
        },
        "settings_flagged": {
          "description": "`differences.csv`'s flagged setting rows.",
          "minimum": 0,
          "title": "Settings Flagged",
          "type": "integer"
        },
        "metrics_unavailable": {
          "description": "`differences.csv`'s `unavailable` metric rows.",
          "minimum": 0,
          "title": "Metrics Unavailable",
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "results",
        "settings_flagged",
        "metrics_unavailable",
        "warnings"
      ],
      "title": "ReviewCounts",
      "type": "object"
    },
    "RunCounts": {
      "additionalProperties": false,
      "description": "The counts of `run` and `demo`.",
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "provider_requests": {
          "description": "The sends of the planned request that may have reached Portfolio123, never\nauthentication.",
          "minimum": 0,
          "title": "Provider Requests",
          "type": "integer"
        },
        "metrics_unavailable": {
          "minimum": 0,
          "title": "Metrics Unavailable",
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The credits Portfolio123 reported charging; null when it reported none.",
          "title": "Cost"
        }
      },
      "required": [
        "attempts",
        "provider_requests",
        "metrics_unavailable",
        "warnings",
        "cost"
      ],
      "title": "RunCounts",
      "type": "object"
    },
    "SummaryCase": {
      "additionalProperties": false,
      "description": "One case of the experiment's plan, as the experiment manifest counts it.",
      "properties": {
        "case_key": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Key",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "unknown",
            "not_yet_run"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "repeat_attempt_id": {
          "anyOf": [
            {
              "format": "uuid4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a case awaiting a repeat, the `attempt_id` that `--repeat <case-key>:<attempt-id>`\nnames to confirm it; null for any other case.",
          "title": "Repeat Attempt Id"
        }
      },
      "required": [
        "case_key",
        "case_id",
        "outcome",
        "repeat_attempt_id"
      ],
      "title": "SummaryCase",
      "type": "object"
    },
    "SummaryIdsV1_2": {
      "additionalProperties": false,
      "description": "The identifiers the command created, in version 1.2.0: 1.1.0's, and an experiment's. A\nkey is left out until its identifier exists. An experiment's `cases` give its cases' and\nattempts' IDs, so its `ids` hold no `case_id` or `attempt_id`.",
      "properties": {
        "plan_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid4",
          "title": "Attempt Id",
          "type": "string"
        },
        "review_id": {
          "format": "uuid4",
          "title": "Review Id",
          "type": "string"
        },
        "experiment_id": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "session": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Session",
          "type": "integer"
        }
      },
      "title": "SummaryIdsV1_2",
      "type": "object"
    },
    "SummaryOutputs": {
      "additionalProperties": false,
      "description": "The output files, relative to `output_dir`, by role. A key is left out for a file the\ncommand didn't write.",
      "properties": {
        "configuration": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Configuration",
          "type": "string"
        },
        "manifest": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Manifest",
          "type": "string"
        },
        "report": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Report",
          "type": "string"
        },
        "metrics": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Metrics",
          "type": "string"
        },
        "settings": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Settings",
          "type": "string"
        },
        "differences": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Differences",
          "type": "string"
        }
      },
      "title": "SummaryOutputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The one JSON object a command writes to stdout with `--json`, on success and on\nfailure: version 1.2.0, which Trial Folio 0.3.0 writes for every command. A 1.1.0 summary\nwith its version changed to 1.2.0 is a valid 1.2.0 summary.",
  "properties": {
    "schema_version": {
      "const": "1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "command": {
      "enum": [
        "init",
        "run",
        "report",
        "demo",
        "license",
        "review"
      ],
      "title": "Command",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        130
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "ids": {
      "$ref": "#/$defs/SummaryIdsV1_2"
    },
    "output_dir": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The output directory as given on the command line, `.` for `trialfolio init` without\none; null if none was created. For an experiment, given once the command writes into it:\nfrom a new experiment's claim, or from a resume's session record.",
      "title": "Output Dir"
    },
    "outputs": {
      "$ref": "#/$defs/SummaryOutputs"
    },
    "cases": {
      "description": "For an experiment only, once its plan is built: each case of the plan this run builds, in\nits order. Left out for every other command and configuration.",
      "items": {
        "$ref": "#/$defs/SummaryCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunCounts"
        },
        {
          "$ref": "#/$defs/ReviewCounts"
        },
        {
          "$ref": "#/$defs/ExperimentCounts"
        },
        {
          "$ref": "#/$defs/NoCounts"
        }
      ],
      "description": "`{}` for `init`, `report`, and `license`, and for an experiment until its counts are\nknown.",
      "title": "Counts"
    },
    "statistical_validation": {
      "const": "not_assessed",
      "title": "Statistical Validation",
      "type": "string"
    },
    "trading_readiness": {
      "const": "not_assessed",
      "title": "Trading Readiness",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "trialfolio_version",
    "outcome",
    "exit_code",
    "ids",
    "output_dir",
    "outputs",
    "counts",
    "statistical_validation",
    "trading_readiness",
    "error"
  ],
  "title": "JsonSummaryV1_2",
  "type": "object"
}
