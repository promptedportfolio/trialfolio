{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.experiment_record.ExperimentRecord, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "CaseChange": {
      "additionalProperties": false,
      "description": "A case a revision added or retired, by its `case_id`, and its key: in the revision for an\nadded case, and in the plan before it for a retired one.",
      "properties": {
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_key": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Key",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_key"
      ],
      "title": "CaseChange",
      "type": "object"
    },
    "DeclaredPriorResearch": {
      "additionalProperties": false,
      "description": "The prior-research declaration as the configuration gives it, with `user_supplied`\nprovenance. Trial Folio can't verify it.",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Given with `complete` or `partial`, and optionally with `unknown`; null when it isn't.",
          "title": "Description"
        }
      },
      "required": [
        "status",
        "description"
      ],
      "title": "DeclaredPriorResearch",
      "type": "object"
    },
    "PlanChanges": {
      "additionalProperties": false,
      "description": "What a revision changed from the plan before it. One whose only change is of versions\nrecords nothing else: it's a change of versions, not of the configuration.",
      "properties": {
        "versions": {
          "description": "Each version that changed, with both values, in the order Trial Folio, `p123api`,\n`requests`, `urllib3`.",
          "items": {
            "$ref": "#/$defs/VersionChange"
          },
          "title": "Versions",
          "type": "array"
        },
        "cases_added": {
          "items": {
            "$ref": "#/$defs/CaseChange"
          },
          "title": "Cases Added",
          "type": "array"
        },
        "cases_retired": {
          "items": {
            "$ref": "#/$defs/CaseChange"
          },
          "title": "Cases Retired",
          "type": "array"
        },
        "parts": {
          "description": "In the documented order: `title`, `purpose`, `prior_research`, `budget`, `case_keys`,\n`case_descriptions`, `case_variants`, `case_order`.",
          "items": {
            "enum": [
              "title",
              "purpose",
              "prior_research",
              "budget",
              "case_keys",
              "case_descriptions",
              "case_variants",
              "case_order"
            ],
            "type": "string"
          },
          "title": "Parts",
          "type": "array"
        }
      },
      "required": [
        "versions",
        "cases_added",
        "cases_retired",
        "parts"
      ],
      "title": "PlanChanges",
      "type": "object"
    },
    "PlanEntry": {
      "additionalProperties": false,
      "description": "One plan of the experiment, in the history of its plans.",
      "properties": {
        "plan": {
          "description": "Its number: its directory's, `plans/<n>/`.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Plan",
          "type": "integer"
        },
        "plan_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "revises": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The hash of the plan before it; null for the first plan.",
          "title": "Revises"
        },
        "plan_artifact_id": {
          "description": "The `artifact_id` of its `plan.json`.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Artifact Id",
          "type": "string"
        },
        "configuration_artifact_id": {
          "description": "The `artifact_id` of its `configuration.yaml`.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configuration Artifact Id",
          "type": "string"
        },
        "approval": {
          "description": "`not_required` for each plan of a synthetic experiment, and for no other plan.",
          "enum": [
            "interactive",
            "option",
            "not_required"
          ],
          "title": "Approval",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The revision's reason, as `--revision-reason` gave it, with `user_supplied` provenance;\nnull for the first plan.",
          "title": "Reason"
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanChanges"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the revision changed from the plan before it; null for the first plan."
        }
      },
      "required": [
        "plan",
        "plan_hash",
        "revises",
        "plan_artifact_id",
        "configuration_artifact_id",
        "approval",
        "reason",
        "changes"
      ],
      "title": "PlanEntry",
      "type": "object"
    },
    "PlanVariant": {
      "additionalProperties": false,
      "description": "A case's variant: the setting it changes, and its change as the configuration gives it: a\n`value`, in the setting's JSON type, with a decimal as its normalized text; an `add`; or a\n`replace` and its `with`. Each key is always written, null where it doesn't apply.",
      "properties": {
        "setting": {
          "enum": [
            "rules",
            "max_holdings",
            "rebalance_weeks",
            "slippage_percent"
          ],
          "title": "Setting",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "add": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Add"
        },
        "replace": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replace"
        },
        "with": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "With"
        },
        "default": {
          "type": "boolean",
          "description": "True for P-13's default rebalance variant, and false otherwise.",
          "title": "Default"
        }
      },
      "required": [
        "setting",
        "value",
        "add",
        "replace",
        "with",
        "default"
      ],
      "title": "PlanVariant",
      "type": "object"
    },
    "RecordedCase": {
      "additionalProperties": false,
      "description": "A case as a plan holds it, without its settings and requests, which its `plan.json`\nholds.",
      "properties": {
        "case_key": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Key",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanVariant"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for the baseline."
        }
      },
      "required": [
        "case_key",
        "case_id",
        "description",
        "variant"
      ],
      "title": "RecordedCase",
      "type": "object"
    },
    "RetiredCase": {
      "additionalProperties": false,
      "description": "A case an earlier plan included and this one doesn't, as the last plan that included it\nheld it. It and its attempts stay in the record.",
      "properties": {
        "case_key": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Key",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanVariant"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for the baseline."
        },
        "plan": {
          "description": "The number of the last plan that included it.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Plan",
          "type": "integer"
        }
      },
      "required": [
        "case_key",
        "case_id",
        "description",
        "variant",
        "plan"
      ],
      "title": "RetiredCase",
      "type": "object"
    },
    "VersionChange": {
      "additionalProperties": false,
      "description": "A version a revision changed: of Trial Folio, or of a package that sends its requests.",
      "properties": {
        "package": {
          "enum": [
            "trialfolio",
            "p123api",
            "requests",
            "urllib3"
          ],
          "title": "Package",
          "type": "string"
        },
        "previous": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Previous",
          "type": "string"
        },
        "current": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Current",
          "type": "string"
        }
      },
      "required": [
        "package",
        "previous",
        "current"
      ],
      "title": "VersionChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`experiment.json`: the experiment as its plan declares it, and every plan so far, oldest\nfirst, ending with its own. It records no outcome: attempts end after it's written.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "experiment_id": {
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Purpose",
      "type": "string"
    },
    "prior_research": {
      "$ref": "#/$defs/DeclaredPriorResearch",
      "description": "As the user declared it. Trial Folio can't verify it."
    },
    "planned_cases": {
      "description": "The plan's cases, in its order, the baseline first.",
      "items": {
        "$ref": "#/$defs/RecordedCase"
      },
      "minItems": 2,
      "title": "Planned Cases",
      "type": "array"
    },
    "retired_cases": {
      "items": {
        "$ref": "#/$defs/RetiredCase"
      },
      "title": "Retired Cases",
      "type": "array"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/PlanEntry"
      },
      "minItems": 1,
      "title": "Plans",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "trialfolio_version",
    "created_at",
    "experiment_id",
    "title",
    "purpose",
    "prior_research",
    "planned_cases",
    "retired_cases",
    "plans"
  ],
  "title": "ExperimentRecord",
  "type": "object"
}
