{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.review_configuration.ReviewConfiguration, in validation mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "IntendedChange": {
      "additionalProperties": false,
      "description": "A change to one setting that a result declares, against the baseline.",
      "properties": {
        "setting": {
          "enum": [
            "universe",
            "rules",
            "ranking",
            "max_holdings",
            "benchmark",
            "start_date",
            "end_date",
            "rebalance_weeks",
            "transaction_price",
            "slippage_percent",
            "pit_method",
            "precision"
          ],
          "title": "Setting",
          "type": "string"
        },
        "reason": {
          "description": "Why the setting was changed, shown in the report: 1 to 500 characters.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "setting",
        "reason"
      ],
      "title": "IntendedChange",
      "type": "object"
    },
    "ReviewResult": {
      "additionalProperties": false,
      "description": "One compared result: a saved run, by its label.",
      "properties": {
        "label": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Label",
          "type": "string"
        },
        "run": {
          "description": "The run's directory, as `trialfolio run` wrote it. A relative path is relative to the\nconfiguration file.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Run",
          "type": "string"
        },
        "description": {
          "description": "Up to 500 characters, shown in the report.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Description",
          "type": "string"
        },
        "intended_changes": {
          "description": "The settings this result changes on purpose. Never on the baseline.",
          "items": {
            "$ref": "#/$defs/IntendedChange"
          },
          "minItems": 1,
          "title": "Intended Changes",
          "type": "array"
        }
      },
      "required": [
        "label",
        "run"
      ],
      "title": "ReviewResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A review configuration, `kind: review`: saved runs compared against an explicit baseline\n(docs/contracts.md, review configuration).",
  "properties": {
    "kind": {
      "const": "review",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Purpose",
      "type": "string"
    },
    "baseline": {
      "description": "The label of the result the others are compared with.",
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Baseline",
      "type": "string"
    },
    "results": {
      "description": "At least two results, in the order the review's outputs list them.",
      "items": {
        "$ref": "#/$defs/ReviewResult"
      },
      "minItems": 2,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "title",
    "baseline",
    "results"
  ],
  "title": "ReviewConfiguration",
  "type": "object"
}
