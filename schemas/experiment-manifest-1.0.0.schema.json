{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.experiment_manifest.ExperimentManifest, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "BudgetLimits": {
      "additionalProperties": false,
      "description": "The current plan's budget, which bounds the whole experiment.",
      "properties": {
        "provider_requests": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Provider Requests",
          "type": "integer"
        },
        "authentication_calls": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Authentication Calls",
          "type": "integer"
        }
      },
      "required": [
        "provider_requests",
        "authentication_calls"
      ],
      "title": "BudgetLimits",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "description": "What the run does and doesn't contain.",
      "properties": {
        "return_series": {
          "description": "`source_only`: the saved response holds per-period series, which are preserved but not\nnormalized, charted, or analyzed. `absent`: no saved response holds any.",
          "enum": [
            "source_only",
            "absent"
          ],
          "title": "Return Series",
          "type": "string"
        },
        "statistical_validation": {
          "const": "not_assessed",
          "title": "Statistical Validation",
          "type": "string"
        },
        "trading_readiness": {
          "const": "not_assessed",
          "title": "Trading Readiness",
          "type": "string"
        }
      },
      "required": [
        "return_series",
        "statistical_validation",
        "trading_readiness"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "CaseCounts": {
      "additionalProperties": false,
      "description": "The current plan's cases, by outcome. They add up to `planned` (R03-AC08).",
      "properties": {
        "planned": {
          "minimum": 2,
          "title": "Planned",
          "type": "integer"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "description": "0.3.0 skips no planned case deliberately, so it's 0.",
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "not_yet_run": {
          "minimum": 0,
          "title": "Not Yet Run",
          "type": "integer"
        }
      },
      "required": [
        "planned",
        "succeeded",
        "failed",
        "skipped",
        "unknown",
        "not_yet_run"
      ],
      "title": "CaseCounts",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "An error, as a stable code and an actionable message (errors).",
      "properties": {
        "code": {
          "enum": [
            "config.invalid",
            "input.not_found",
            "input.not_a_run",
            "artifact.unknown_schema_version",
            "environment.unsupported",
            "license.not_acknowledged",
            "plan.approval_required",
            "plan.changed",
            "output.not_empty",
            "storage.write_failed",
            "experiment.locked",
            "provider.auth_failed",
            "provider.unavailable",
            "provider.quota_exceeded",
            "provider.unsupported_capability",
            "provider.request_rejected",
            "provider.response_invalid",
            "provider.outcome_unknown",
            "execution.partial",
            "command.interrupted",
            "internal.unexpected"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExperimentArtifact": {
      "additionalProperties": false,
      "description": "One file of the experiment's records, by path, content address, and role.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "role": {
          "enum": [
            "configuration",
            "plan",
            "experiment_record",
            "authentication_record",
            "start_record",
            "attempt_record",
            "provider_request",
            "provider_response",
            "provider_response_undecoded",
            "metrics",
            "settings",
            "session_record",
            "report"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's schema version, for files that have one.",
          "title": "Schema Version"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "Given exactly for source artifacts."
        }
      },
      "required": [
        "path",
        "artifact_id",
        "size",
        "role",
        "schema_version",
        "source"
      ],
      "title": "ExperimentArtifact",
      "type": "object"
    },
    "ExperimentAttemptCounts": {
      "additionalProperties": false,
      "description": "Every attempt of the experiment, retired cases' included, by outcome, and how many of them\nrepeat a case.",
      "properties": {
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "running": {
          "minimum": 0,
          "title": "Running",
          "type": "integer"
        },
        "repeats": {
          "description": "The attempts that `--repeat` started: those with a `repeat_of`.",
          "minimum": 0,
          "title": "Repeats",
          "type": "integer"
        }
      },
      "required": [
        "succeeded",
        "failed",
        "unknown",
        "running",
        "repeats"
      ],
      "title": "ExperimentAttemptCounts",
      "type": "object"
    },
    "ExperimentCommandRecord": {
      "additionalProperties": false,
      "description": "The command that ran the session, its non-secret options, and when it started.",
      "properties": {
        "name": {
          "const": "run",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/ExperimentOptions"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "options",
        "started_at"
      ],
      "title": "ExperimentCommandRecord",
      "type": "object"
    },
    "ExperimentManifestCounts": {
      "additionalProperties": false,
      "description": "The experiment's counts, across every run of it.",
      "properties": {
        "cases": {
          "$ref": "#/$defs/CaseCounts"
        },
        "retired_cases": {
          "description": "How many cases revisions retired. Their attempts are counted with the others.",
          "minimum": 0,
          "title": "Retired Cases",
          "type": "integer"
        },
        "attempts": {
          "$ref": "#/$defs/ExperimentAttemptCounts"
        },
        "retries": {
          "const": 0,
          "description": "Trial Folio never resends a request on its own.",
          "title": "Retries",
          "type": "integer"
        },
        "provider_requests": {
          "description": "The sends that may have reached Portfolio123, a `running` attempt counted as one, as the\nbudget counts them. A revision may set a budget below them.",
          "minimum": 0,
          "title": "Provider Requests",
          "type": "integer"
        },
        "authentication_calls": {
          "description": "Trial Folio's own authentication calls, whatever their result, as the budget counts them.",
          "minimum": 0,
          "title": "Authentication Calls",
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/BudgetLimits"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The credits Portfolio123 reported charging; null when it reported none.",
          "title": "Cost"
        }
      },
      "required": [
        "cases",
        "retired_cases",
        "attempts",
        "retries",
        "provider_requests",
        "authentication_calls",
        "budget",
        "cost"
      ],
      "title": "ExperimentManifestCounts",
      "type": "object"
    },
    "ExperimentOptions": {
      "additionalProperties": false,
      "description": "The run's options. Neither the configuration's path nor `--out` is recorded, because a\npath can name the user. The reason's text is in `experiment.json`, and the repeats are in\nthe attempts' `repeat_of`.",
      "properties": {
        "approve": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approve"
        },
        "json": {
          "title": "Json",
          "type": "boolean"
        },
        "revision_reason": {
          "title": "Revision Reason",
          "type": "boolean"
        },
        "repeat": {
          "title": "Repeat",
          "type": "boolean"
        }
      },
      "required": [
        "approve",
        "json",
        "revision_reason",
        "repeat"
      ],
      "title": "ExperimentOptions",
      "type": "object"
    },
    "ExternalReference": {
      "additionalProperties": false,
      "description": "A setting that names a mutable object in the provider account.",
      "properties": {
        "setting": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Setting",
          "type": "string"
        },
        "snapshotted": {
          "title": "Snapshotted",
          "type": "boolean"
        }
      },
      "required": [
        "setting",
        "snapshotted"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "ParserVersion": {
      "additionalProperties": false,
      "description": "The parser version applied to one provider response layout.",
      "properties": {
        "layout": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Layout",
          "type": "string"
        },
        "layout_version": {
          "minimum": 1,
          "title": "Layout Version",
          "type": "integer"
        },
        "parser_version": {
          "minimum": 1,
          "title": "Parser Version",
          "type": "integer"
        }
      },
      "required": [
        "layout",
        "layout_version",
        "parser_version"
      ],
      "title": "ParserVersion",
      "type": "object"
    },
    "Reproducibility": {
      "additionalProperties": false,
      "description": "Whether the run's settings fully record what was run. A reference to an account object\nthat wasn't snapshotted makes it incomplete.",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "external_references": {
          "items": {
            "$ref": "#/$defs/ExternalReference"
          },
          "title": "External References",
          "type": "array"
        }
      },
      "required": [
        "status",
        "external_references"
      ],
      "title": "Reproducibility",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "What makes a file a source artifact: when and how it was acquired, and how it's read.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "format": {
          "description": "The source format, such as `screen-configuration` or `p123api-screen-backtest`.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format",
          "type": "string"
        },
        "format_version": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format Version",
          "type": "string"
        },
        "parser_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The version of the adapter that interpreted it; null when nothing interpreted it.",
          "title": "Parser Version"
        },
        "provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "const": "screen_backtest",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The provider operation that produced it; null for a file the user wrote.",
          "title": "Operation"
        }
      },
      "required": [
        "acquired_at",
        "format",
        "format_version",
        "parser_version",
        "provenance",
        "operation"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The manifest a session of an experiment writes last, when it reaches its end.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "experiment",
      "title": "Artifact Type",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "experiment_id": {
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "session": {
      "description": "The number of the session that wrote it, in whose directory it is.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Session",
      "type": "integer"
    },
    "command": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExperimentCommandRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when no `trialfolio` command ran the session, as when the core runs it for another\ninterface, or writes a synthetic experiment."
    },
    "synthetic": {
      "description": "True exactly for an experiment executed with the demo's client, which sends nothing. Its\nvalues, attempts, and counts are invented.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "plan": {
      "description": "The current plan's number.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Plan",
      "type": "integer"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "approval": {
      "description": "How this run approved the current plan: `not_required` exactly for a synthetic\nexperiment.",
      "enum": [
        "interactive",
        "option",
        "not_required"
      ],
      "title": "Approval",
      "type": "string"
    },
    "outcome": {
      "description": "`completed` when every planned case succeeded, and `partial` otherwise.",
      "enum": [
        "completed",
        "partial"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when completed, and `execution.partial` when partial."
    },
    "artifacts": {
      "description": "Every file of the experiment's records: each plan's three files, each attempt's files,\neach case's tables, and this session's record and report. Not `experiment.lock`, `logs/`,\nother sessions' files, or a plan's directory without `experiment.json`.",
      "items": {
        "$ref": "#/$defs/ExperimentArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "parsers": {
      "description": "Each parser version that normalized a case's response, or the installed one's when none\ndid.",
      "items": {
        "$ref": "#/$defs/ParserVersion"
      },
      "minItems": 1,
      "title": "Parsers",
      "type": "array"
    },
    "license_id": {
      "pattern": "^LicenseRef-[A-Za-z0-9.-]+$",
      "title": "License Id",
      "type": "string"
    },
    "notice_version": {
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Notice Version",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "reproducibility": {
      "$ref": "#/$defs/Reproducibility",
      "description": "Over the current plan's cases."
    },
    "counts": {
      "$ref": "#/$defs/ExperimentManifestCounts"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "trialfolio_version",
    "created_at",
    "experiment_id",
    "session",
    "command",
    "synthetic",
    "plan",
    "plan_hash",
    "approval",
    "outcome",
    "error",
    "artifacts",
    "parsers",
    "license_id",
    "notice_version",
    "capabilities",
    "reproducibility",
    "counts"
  ],
  "title": "ExperimentManifest",
  "type": "object"
}
