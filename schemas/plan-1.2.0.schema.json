{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.plan.PlanV1_2, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "DataSentV1_2": {
      "additionalProperties": false,
      "description": "A category of data that leaves the machine, in a plan with a ranking definition.",
      "properties": {
        "category": {
          "enum": [
            "credentials",
            "strategy_definition",
            "backtest_settings"
          ],
          "title": "Category",
          "type": "string"
        },
        "recipient": {
          "const": "Portfolio123",
          "title": "Recipient",
          "type": "string"
        },
        "via": {
          "const": "p123api",
          "title": "Via",
          "type": "string"
        },
        "settings": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "recipient",
        "via",
        "settings"
      ],
      "title": "DataSentV1_2",
      "type": "object"
    },
    "DefinitionRankingSetting": {
      "additionalProperties": false,
      "description": "A ranking given as a definition, in a file or by a snapshot, as a case's resolved\n`ranking` holds it: the definition's hash and its ranking method, in place of the\nconfiguration's keys. So the `case_id` covers the definition, byte for byte, and its ranking\nmethod, and nothing about where it came from (ranking definitions).",
      "properties": {
        "definition": {
          "description": "`sha256:` and the hex SHA-256 of the definition's UTF-8 text.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition",
          "type": "string"
        },
        "ranking_method": {
          "enum": [
            "percentile_nas_negative",
            "percentile_nas_neutral"
          ],
          "title": "Ranking Method",
          "type": "string"
        }
      },
      "required": [
        "definition",
        "ranking_method"
      ],
      "title": "DefinitionRankingSetting",
      "type": "object"
    },
    "DocumentedSource": {
      "additionalProperties": false,
      "description": "Where a documented value comes from, and the date the documentation was checked.",
      "properties": {
        "title": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "checked"
      ],
      "title": "DocumentedSource",
      "type": "object"
    },
    "FormulaRankingParams": {
      "additionalProperties": false,
      "description": "A single-formula ranking, as sent.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        },
        "lowerIsBetter": {
          "title": "Lowerisbetter",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "lowerIsBetter"
      ],
      "title": "FormulaRankingParams",
      "type": "object"
    },
    "OperationCost": {
      "additionalProperties": false,
      "description": "One operation's documented cost, in credits, when the plan was made, and its source.",
      "properties": {
        "operation": {
          "enum": [
            "rank_update",
            "screen_backtest"
          ],
          "title": "Operation",
          "type": "string"
        },
        "credits_per_request": {
          "minimum": 0,
          "title": "Credits Per Request",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/DocumentedSource"
        }
      },
      "required": [
        "operation",
        "credits_per_request",
        "source"
      ],
      "title": "OperationCost",
      "type": "object"
    },
    "PlanBudgetV1_2": {
      "additionalProperties": false,
      "description": "The budget of a screen whose ranking is a definition: its two requests, the `rank_update`\nand the backtest, each operation's documented cost, and the most they can cost.",
      "properties": {
        "provider_requests": {
          "const": 2,
          "description": "The case's `rank_update` and its backtest, each sent at most once.",
          "title": "Provider Requests",
          "type": "integer"
        },
        "costs": {
          "description": "`rank_update`'s documented cost, then the backtest's, in place of 1.0.0's\n`credits_per_request` and its source.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/OperationCost"
            },
            {
              "$ref": "#/$defs/OperationCost"
            }
          ],
          "title": "Costs",
          "type": "array"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "integer"
        },
        "authentication_calls": {
          "const": 1,
          "title": "Authentication Calls",
          "type": "integer"
        }
      },
      "required": [
        "provider_requests",
        "costs",
        "credits",
        "authentication_calls"
      ],
      "title": "PlanBudgetV1_2",
      "type": "object"
    },
    "PlanCaseV1_2": {
      "additionalProperties": false,
      "description": "The one case of a screen whose ranking is a definition: its `rank_update`, then its\nbacktest, ranked by `ApiRankingSystem`, and its settings, with a weight row for each node.",
      "properties": {
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "requests": {
          "description": "The `rank_update` that writes the case's whole definition, then the backtest.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RankUpdateRequest"
            },
            {
              "$ref": "#/$defs/PlanRequest"
            }
          ],
          "title": "Requests",
          "type": "array"
        },
        "settings": {
          "items": {
            "$ref": "#/$defs/PlanSettingV1_2"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "requests",
        "settings"
      ],
      "title": "PlanCaseV1_2",
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "description": "One provider request a case needs.",
      "properties": {
        "operation": {
          "const": "screen_backtest",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ScreenBacktestParams"
        }
      },
      "required": [
        "operation",
        "params"
      ],
      "title": "PlanRequest",
      "type": "object"
    },
    "PlanSettingV1_2": {
      "additionalProperties": false,
      "description": "One resolved setting of a plan with a ranking definition: 1.0.0's row, with `node` after\n`setting`: a weight row's canonical path, and null on every other row.",
      "properties": {
        "setting": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Setting",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A weight row's node, by its canonical path; null on every other row.",
          "title": "Node"
        },
        "category": {
          "enum": [
            "dates",
            "benchmark",
            "currency",
            "costs",
            "execution",
            "universe",
            "data_source",
            "strategy",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/SettingValueV1_2"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "count",
                "weeks",
                "percent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "interpretation": {
          "enum": [
            "interpreted",
            "not_interpreted"
          ],
          "title": "Interpretation",
          "type": "string"
        },
        "expected_provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Expected Provenance",
          "type": "string"
        },
        "inference_rule": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inference Rule"
        },
        "flags": {
          "items": {
            "enum": [
              "inferred_default",
              "not_snapshotted"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "setting",
        "node",
        "category",
        "critical",
        "value",
        "unit",
        "interpretation",
        "expected_provenance",
        "inference_rule",
        "flags"
      ],
      "title": "PlanSettingV1_2",
      "type": "object"
    },
    "RankUpdateParams": {
      "additionalProperties": false,
      "description": "The params passed to p123api's `rank_update`, exactly as they're sent, in this order: the\nfixed type, the case's whole definition, its ranking method's number, and the fixed currency.\nThere's no `id`, so the call writes `ApiRankingSystem` (sending a definition).",
      "properties": {
        "type": {
          "const": "stock",
          "title": "Type",
          "type": "string"
        },
        "nodes": {
          "description": "The case's whole definition, as its file's text reads, each line end a line feed.",
          "minLength": 1,
          "title": "Nodes",
          "type": "string"
        },
        "rankingMethod": {
          "description": "2 for `percentile_nas_negative`, and 4 for `percentile_nas_neutral`.",
          "enum": [
            2,
            4
          ],
          "title": "Rankingmethod",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "type",
        "nodes",
        "rankingMethod",
        "currency"
      ],
      "title": "RankUpdateParams",
      "type": "object"
    },
    "RankUpdateRequest": {
      "additionalProperties": false,
      "description": "A case's first request: the `rank_update` that writes its definition into\n`ApiRankingSystem`.",
      "properties": {
        "operation": {
          "const": "rank_update",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RankUpdateParams"
        }
      },
      "required": [
        "operation",
        "params"
      ],
      "title": "RankUpdateRequest",
      "type": "object"
    },
    "RankingSource": {
      "additionalProperties": false,
      "description": "Where the plan's ranking definition came from, which the plan hash covers and no `case_id`\ndoes: a file, by the definition's hash, or a snapshot, by its system's name and the\n`artifact_id`s of its `snapshot.json` and `definition.xml` (ranking definitions). Each field\nis always written, null where the form has none.",
      "properties": {
        "form": {
          "enum": [
            "definition",
            "snapshot"
          ],
          "title": "Form",
          "type": "string"
        },
        "definition": {
          "description": "The definition's hash, which the baseline's `ranking` setting holds too.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A snapshot's system's name, as its record gives it in `system.name`; null for a file.",
          "title": "System"
        },
        "snapshot_record": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `artifact_id` of a snapshot's `snapshot.json`; null for a file.",
          "title": "Snapshot Record"
        },
        "snapshot_definition": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `artifact_id` of a snapshot's `definition.xml`; null for a file.",
          "title": "Snapshot Definition"
        }
      },
      "required": [
        "form",
        "definition",
        "system",
        "snapshot_record",
        "snapshot_definition"
      ],
      "title": "RankingSource",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "The retry policy: no automatic retries, and one exchange per wrapper call.",
      "properties": {
        "automatic_retries": {
          "const": 0,
          "title": "Automatic Retries",
          "type": "integer"
        },
        "wrapper_attempts_per_call": {
          "const": 1,
          "title": "Wrapper Attempts Per Call",
          "type": "integer"
        },
        "exchanges_per_call": {
          "const": 1,
          "title": "Exchanges Per Call",
          "type": "integer"
        }
      },
      "required": [
        "automatic_retries",
        "wrapper_attempts_per_call",
        "exchanges_per_call"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "ScreenBacktestParams": {
      "additionalProperties": false,
      "description": "The JSON object passed to p123api's `screen_backtest`, exactly as it will be sent.\n\n`slippage` is always a JSON float, and every other number an integer (plan contents).",
      "properties": {
        "screen": {
          "$ref": "#/$defs/ScreenParams"
        },
        "startDt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Startdt",
          "type": "string"
        },
        "endDt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Enddt",
          "type": "string"
        },
        "pitMethod": {
          "const": "Complete",
          "title": "Pitmethod",
          "type": "string"
        },
        "precision": {
          "const": 4,
          "title": "Precision",
          "type": "integer"
        },
        "transPrice": {
          "const": 1,
          "title": "Transprice",
          "type": "integer"
        },
        "slippage": {
          "title": "Slippage",
          "type": "number"
        },
        "rebalFreq": {
          "enum": [
            "Every Week",
            "Every 4 Weeks"
          ],
          "title": "Rebalfreq",
          "type": "string"
        }
      },
      "required": [
        "screen",
        "startDt",
        "endDt",
        "pitMethod",
        "precision",
        "transPrice",
        "slippage",
        "rebalFreq"
      ],
      "title": "ScreenBacktestParams",
      "type": "object"
    },
    "ScreenParams": {
      "additionalProperties": false,
      "description": "The `screen` object of a screen backtest request.",
      "properties": {
        "type": {
          "const": "stock",
          "title": "Type",
          "type": "string"
        },
        "universe": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Universe",
          "type": "string"
        },
        "maxNumHoldings": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Maxnumholdings",
          "type": "integer"
        },
        "method": {
          "const": "long",
          "title": "Method",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "benchmark": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Benchmark",
          "type": "string"
        },
        "ranking": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaRankingParams"
            },
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "title": "Ranking"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ScreenRuleParams"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "type",
        "universe",
        "maxNumHoldings",
        "method",
        "currency",
        "benchmark",
        "ranking",
        "rules"
      ],
      "title": "ScreenParams",
      "type": "object"
    },
    "ScreenRuleParams": {
      "additionalProperties": false,
      "description": "One screening rule, as sent. It has no `type` field: Portfolio123 rejects one.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        }
      },
      "required": [
        "formula"
      ],
      "title": "ScreenRuleParams",
      "type": "object"
    },
    "SettingValueV1_2": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "items": {
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/DefinitionRankingSetting"
        }
      ]
    },
    "TransportVersions": {
      "additionalProperties": false,
      "description": "The installed `requests` and `urllib3`, which carry the wrapper's requests.",
      "properties": {
        "requests": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Requests",
          "type": "string"
        },
        "urllib3": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Urllib3",
          "type": "string"
        }
      },
      "required": [
        "requests",
        "urllib3"
      ],
      "title": "TransportVersions",
      "type": "object"
    },
    "WrapperVersions": {
      "additionalProperties": false,
      "description": "The installed `p123api`, which sends the requests (plan contents).",
      "properties": {
        "p123api": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "P123Api",
          "type": "string"
        }
      },
      "required": [
        "p123api"
      ],
      "title": "WrapperVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A screen's plan whose ranking is a definition: its one case's `rank_update` and backtest,\nwith the whole definition, the definition's source, the budget with each operation's cost,\nthe retry policy, and the data sent. Execution requires its `plan_hash` as approval (plans\nwith a ranking definition).",
  "properties": {
    "schema_version": {
      "const": "1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "canonicalization_version": {
      "const": 1,
      "title": "Canonicalization Version",
      "type": "integer"
    },
    "provider_wrapper": {
      "$ref": "#/$defs/WrapperVersions"
    },
    "transport": {
      "$ref": "#/$defs/TransportVersions"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Purpose"
    },
    "ranking_source": {
      "$ref": "#/$defs/RankingSource"
    },
    "cases": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/PlanCaseV1_2"
        }
      ],
      "title": "Cases",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/PlanBudgetV1_2"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "data_sent": {
      "items": {
        "$ref": "#/$defs/DataSentV1_2"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Data Sent",
      "type": "array"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trialfolio_version",
    "canonicalization_version",
    "provider_wrapper",
    "transport",
    "title",
    "purpose",
    "ranking_source",
    "cases",
    "budget",
    "retry_policy",
    "data_sent",
    "plan_hash"
  ],
  "title": "PlanV1_2",
  "type": "object"
}
