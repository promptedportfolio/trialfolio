{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.attempt.AttemptRecordV1_3, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "A file in the output directory, by path and content address.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "artifact_id"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "An error, as a stable code and an actionable message (errors).",
      "properties": {
        "code": {
          "enum": [
            "config.invalid",
            "input.not_found",
            "input.not_a_run",
            "artifact.unknown_schema_version",
            "environment.unsupported",
            "license.not_acknowledged",
            "plan.approval_required",
            "plan.changed",
            "output.not_empty",
            "storage.write_failed",
            "experiment.locked",
            "provider.auth_failed",
            "provider.unavailable",
            "provider.quota_exceeded",
            "provider.unsupported_capability",
            "provider.request_rejected",
            "provider.response_invalid",
            "provider.outcome_unknown",
            "execution.partial",
            "command.interrupted",
            "internal.unexpected"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Exchange": {
      "additionalProperties": false,
      "description": "One HTTP exchange the wrapper made through Trial Folio's transport adapter (HTTP\nexchanges). Nothing else about it is kept: no headers, tokens, bodies, or exceptions.",
      "properties": {
        "request": {
          "description": "The method and path, such as `POST /auth` or `POST /screen/backtest`.",
          "pattern": "^[A-Z]+ /[^\\s]*$",
          "title": "Request",
          "type": "string"
        },
        "result": {
          "enum": [
            "response",
            "not_connected",
            "interrupted"
          ],
          "title": "Result",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The HTTP status of a `response`; null otherwise.",
          "title": "Status"
        },
        "note": {
          "anyOf": [
            {
              "const": "completed_from_saved_response",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set only on a restarted attempt's request exchange, recorded as a 200 because its response\nwas found saved (uncertain completion); null otherwise.",
          "title": "Note"
        }
      },
      "required": [
        "request",
        "result",
        "status",
        "note"
      ],
      "title": "Exchange",
      "type": "object"
    },
    "ProviderMetadata": {
      "additionalProperties": false,
      "description": "What the provider reported about the charge: `cost` and `quotaRemaining`. Each is null when\nthe response doesn't carry it.",
      "properties": {
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost"
        },
        "quota_remaining": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "`quotaRemaining`: account information, kept out of shareable outputs.",
          "title": "Quota Remaining"
        }
      },
      "required": [
        "cost",
        "quota_remaining"
      ],
      "title": "ProviderMetadata",
      "type": "object"
    },
    "RankUpdateResponse": {
      "additionalProperties": false,
      "description": "The `rank_update`'s saved response: `rank-update-response.json`, the decoded payload, or\n`rank-update-response.raw`, the body of a 200 the wrapper couldn't decode.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "form": {
          "enum": [
            "decoded",
            "undecoded"
          ],
          "title": "Form",
          "type": "string"
        }
      },
      "required": [
        "path",
        "artifact_id",
        "form"
      ],
      "title": "RankUpdateResponse",
      "type": "object"
    },
    "RankingUpdate": {
      "additionalProperties": false,
      "description": "The `rank_update` an attempt sent before its backtest: its request, its saved response,\nand what Portfolio123 reported of its charge (sending a definition).",
      "properties": {
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "`rank-update-request.json`; null when the attempt ended before writing it."
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/RankUpdateResponse"
            },
            {
              "type": "null"
            }
          ],
          "description": "The saved response; null when none was saved."
        },
        "provider_metadata": {
          "$ref": "#/$defs/ProviderMetadata",
          "description": "The `cost` and `quotaRemaining` of its decoded response, each null when it doesn't carry\nit."
        }
      },
      "required": [
        "request",
        "response",
        "provider_metadata"
      ],
      "title": "RankingUpdate",
      "type": "object"
    },
    "SavedResponse": {
      "additionalProperties": false,
      "description": "The saved response: `response.json`, the decoded payload, or `response.raw`, the body of a\n200 the wrapper couldn't decode.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "form": {
          "enum": [
            "decoded",
            "undecoded"
          ],
          "title": "Form",
          "type": "string"
        }
      },
      "required": [
        "path",
        "artifact_id",
        "form"
      ],
      "title": "SavedResponse",
      "type": "object"
    },
    "TransportVersions": {
      "additionalProperties": false,
      "description": "The installed `requests` and `urllib3`, which carry the wrapper's requests.",
      "properties": {
        "requests": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Requests",
          "type": "string"
        },
        "urllib3": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Urllib3",
          "type": "string"
        }
      },
      "required": [
        "requests",
        "urllib3"
      ],
      "title": "TransportVersions",
      "type": "object"
    },
    "WrapperVersions": {
      "additionalProperties": false,
      "description": "The installed `p123api`, which sends the requests (plan contents).",
      "properties": {
        "p123api": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "P123Api",
          "type": "string"
        }
      },
      "required": [
        "p123api"
      ],
      "title": "WrapperVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An attempt record 1.3.0: an experiment's attempt that sends a definition, written once\nwhen it ends: 1.1.0's fields, with its `operation` and its `rank_update`.",
  "properties": {
    "schema_version": {
      "const": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "attempt_id": {
      "format": "uuid4",
      "title": "Attempt Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^case-[0-9a-f]{16}$",
      "title": "Case Id",
      "type": "string"
    },
    "plan_hash": {
      "description": "The plan the attempt runs under.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "session": {
      "description": "The number of the session that started the attempt.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Session",
      "type": "integer"
    },
    "sequence": {
      "description": "The attempt's place in its session.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "operation": {
      "const": "screen_backtest",
      "description": "The attempt's last request, its backtest.",
      "title": "Operation",
      "type": "string"
    },
    "authenticated_by": {
      "anyOf": [
        {
          "format": "uuid4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "As in its start records, given exactly when it has one.",
      "title": "Authenticated By"
    },
    "repeat_of": {
      "anyOf": [
        {
          "format": "uuid4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Repeat Of"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "provider_wrapper": {
      "$ref": "#/$defs/WrapperVersions"
    },
    "transport": {
      "$ref": "#/$defs/TransportVersions"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null exactly when the outcome is `succeeded`."
    },
    "exchanges": {
      "description": "Every exchange of this attempt, in order. It has no authentication exchange when it sent\nwith an earlier attempt's token.",
      "items": {
        "$ref": "#/$defs/Exchange"
      },
      "title": "Exchanges",
      "type": "array"
    },
    "possibly_charged": {
      "title": "Possibly Charged",
      "type": "boolean"
    },
    "ranking_update": {
      "$ref": "#/$defs/RankingUpdate",
      "description": "The `rank_update`'s request, response, and provider metadata."
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "description": "The backtest's redacted request, `request.json`."
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/SavedResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_metadata": {
      "$ref": "#/$defs/ProviderMetadata",
      "description": "The backtest's."
    }
  },
  "required": [
    "schema_version",
    "trialfolio_version",
    "attempt_id",
    "case_id",
    "plan_hash",
    "session",
    "sequence",
    "operation",
    "authenticated_by",
    "repeat_of",
    "started_at",
    "provider_wrapper",
    "transport",
    "ended_at",
    "outcome",
    "error",
    "exchanges",
    "possibly_charged",
    "ranking_update",
    "request",
    "response",
    "provider_metadata"
  ],
  "title": "AttemptRecordV1_3",
  "type": "object"
}
