{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.ranking_snapshot.RankingSnapshotManifest, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "AttemptCounts": {
      "additionalProperties": false,
      "description": "Attempts, by outcome.",
      "properties": {
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "running": {
          "minimum": 0,
          "title": "Running",
          "type": "integer"
        }
      },
      "required": [
        "succeeded",
        "failed",
        "unknown",
        "running"
      ],
      "title": "AttemptCounts",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "An error, as a stable code and an actionable message (errors).",
      "properties": {
        "code": {
          "enum": [
            "config.invalid",
            "input.not_found",
            "input.not_a_run",
            "artifact.unknown_schema_version",
            "environment.unsupported",
            "license.not_acknowledged",
            "plan.approval_required",
            "plan.changed",
            "output.not_empty",
            "storage.write_failed",
            "experiment.locked",
            "provider.auth_failed",
            "provider.unavailable",
            "provider.quota_exceeded",
            "provider.unsupported_capability",
            "provider.request_rejected",
            "provider.response_invalid",
            "provider.outcome_unknown",
            "execution.partial",
            "command.interrupted",
            "internal.unexpected"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ParserVersion": {
      "additionalProperties": false,
      "description": "The parser version applied to one provider response layout.",
      "properties": {
        "layout": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Layout",
          "type": "string"
        },
        "layout_version": {
          "minimum": 1,
          "title": "Layout Version",
          "type": "integer"
        },
        "parser_version": {
          "minimum": 1,
          "title": "Parser Version",
          "type": "integer"
        }
      },
      "required": [
        "layout",
        "layout_version",
        "parser_version"
      ],
      "title": "ParserVersion",
      "type": "object"
    },
    "SnapshotArtifact": {
      "additionalProperties": false,
      "description": "One file of a snapshot, by path, content address, and role.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "role": {
          "enum": [
            "plan",
            "configuration",
            "start_record",
            "attempt_record",
            "provider_request",
            "provider_response",
            "provider_response_undecoded",
            "ranking_definition",
            "ranking_snapshot_record"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's schema version, for files that have one.",
          "title": "Schema Version"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRecordV1_1"
            },
            {
              "type": "null"
            }
          ],
          "description": "Given exactly for source artifacts."
        }
      },
      "required": [
        "path",
        "artifact_id",
        "size",
        "role",
        "schema_version",
        "source"
      ],
      "title": "SnapshotArtifact",
      "type": "object"
    },
    "SnapshotCommandRecord": {
      "additionalProperties": false,
      "description": "The command that took the snapshot, its non-secret options, and when it started.",
      "properties": {
        "name": {
          "const": "run",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/SnapshotOptions"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "options",
        "started_at"
      ],
      "title": "SnapshotCommandRecord",
      "type": "object"
    },
    "SnapshotCounts": {
      "additionalProperties": false,
      "description": "The snapshot's counts.",
      "properties": {
        "attempts": {
          "$ref": "#/$defs/AttemptCounts"
        },
        "provider_requests": {
          "description": "The `rank_get` sent, when it may have reached Portfolio123.",
          "maximum": 1,
          "minimum": 0,
          "title": "Provider Requests",
          "type": "integer"
        },
        "retries": {
          "const": 0,
          "description": "Trial Folio never resends a request on its own.",
          "title": "Retries",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The credits Portfolio123 reported charging; null when it reported none.",
          "title": "Cost"
        }
      },
      "required": [
        "attempts",
        "provider_requests",
        "retries",
        "cost"
      ],
      "title": "SnapshotCounts",
      "type": "object"
    },
    "SnapshotOptions": {
      "additionalProperties": false,
      "description": "The run's options. Neither the configuration's path nor `--out` is recorded, because a\npath can name the user.",
      "properties": {
        "approve": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approve"
        },
        "json": {
          "title": "Json",
          "type": "boolean"
        }
      },
      "required": [
        "approve",
        "json"
      ],
      "title": "SnapshotOptions",
      "type": "object"
    },
    "SourceRecordV1_1": {
      "additionalProperties": false,
      "description": "A source record in a manifest with a ranking definition: 1.0.0's, whose provider operation\nmay also be the `rank_update` or a snapshot's `rank_get`.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "format": {
          "description": "The source format, such as `ranking-definition` or `p123api-rank-update`.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format",
          "type": "string"
        },
        "format_version": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format Version",
          "type": "string"
        },
        "parser_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The version of the adapter that interpreted it; null when nothing interpreted it.",
          "title": "Parser Version"
        },
        "provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "enum": [
                "screen_backtest",
                "rank_update",
                "rank_get"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The provider operation that produced it; null for a file the user wrote.",
          "title": "Operation"
        }
      },
      "required": [
        "acquired_at",
        "format",
        "format_version",
        "parser_version",
        "provenance",
        "operation"
      ],
      "title": "SourceRecordV1_1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The snapshot manifest, `manifest.json` with `artifact_type: ranking-snapshot`, written\nlast: a run's manifest, without capabilities or reproducibility, since a snapshot holds no\nresult or series and has no settings. A synthetic snapshot, which only the core takes, with\nthe demo's client, has no command and the approval `not_required`, and no configuration can\nname it as its ranking.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "ranking-snapshot",
      "title": "Artifact Type",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "command": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotCommandRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null for a synthetic snapshot, which no command takes."
    },
    "synthetic": {
      "description": "True exactly for a snapshot taken with the demo's client, which sends nothing and answers\n`rank_get` with an invented system. Its system, definition, and attempt are invented.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "approval": {
      "description": "`interactive` or `option`; `not_required` exactly for a synthetic snapshot.",
      "enum": [
        "interactive",
        "option",
        "not_required"
      ],
      "title": "Approval",
      "type": "string"
    },
    "outcome": {
      "description": "`completed` once `snapshot.json` is written, and `failed` otherwise.",
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null exactly when the outcome is `completed`."
    },
    "artifacts": {
      "description": "Every file but the manifest itself and the logs.",
      "items": {
        "$ref": "#/$defs/SnapshotArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "parsers": {
      "description": "`p123api-rank-get`, layout version 1, parser version 1.",
      "items": {
        "$ref": "#/$defs/ParserVersion"
      },
      "minItems": 1,
      "title": "Parsers",
      "type": "array"
    },
    "license_id": {
      "pattern": "^LicenseRef-[A-Za-z0-9.-]+$",
      "title": "License Id",
      "type": "string"
    },
    "notice_version": {
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Notice Version",
      "type": "string"
    },
    "counts": {
      "$ref": "#/$defs/SnapshotCounts"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "trialfolio_version",
    "created_at",
    "command",
    "synthetic",
    "plan_hash",
    "approval",
    "outcome",
    "error",
    "artifacts",
    "parsers",
    "license_id",
    "notice_version",
    "counts"
  ],
  "title": "RankingSnapshotManifest",
  "type": "object"
}
