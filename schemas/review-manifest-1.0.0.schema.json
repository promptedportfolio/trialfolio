{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.review_manifest.ReviewManifest, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "Method": {
      "additionalProperties": false,
      "description": "An analytical method the review applied, with its version. A 1.0.0 review applies\n`screen-run-differences`, the rules of docs/contracts.md's differences between screen runs.\nA change to them that could change a row of `differences.csv` makes a new version.",
      "properties": {
        "name": {
          "const": "screen-run-differences",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Method",
      "type": "object"
    },
    "MetricRowCounts": {
      "additionalProperties": false,
      "description": "`differences.csv`'s metric rows, by classification, and how many are flagged.",
      "properties": {
        "differenced": {
          "minimum": 0,
          "title": "Differenced",
          "type": "integer"
        },
        "not_comparable": {
          "minimum": 0,
          "title": "Not Comparable",
          "type": "integer"
        },
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        },
        "flagged": {
          "minimum": 0,
          "title": "Flagged",
          "type": "integer"
        }
      },
      "required": [
        "differenced",
        "not_comparable",
        "unavailable",
        "flagged"
      ],
      "title": "MetricRowCounts",
      "type": "object"
    },
    "ReviewArtifact": {
      "additionalProperties": false,
      "description": "One file of the review, by path, content address, and role.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "role": {
          "enum": [
            "configuration",
            "run_manifest",
            "plan",
            "metrics",
            "settings",
            "differences",
            "report"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's schema version. Every file but the report has one: a copy's is the one its\nrun records.",
          "title": "Schema Version"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "Given exactly for `configuration.yaml`, the review's one source artifact."
        },
        "label": {
          "anyOf": [
            {
              "not": {
                "enum": [
                  "con",
                  "prn",
                  "aux",
                  "nul",
                  "com1",
                  "com2",
                  "com3",
                  "com4",
                  "com5",
                  "com6",
                  "com7",
                  "com8",
                  "com9",
                  "lpt1",
                  "lpt2",
                  "lpt3",
                  "lpt4",
                  "lpt5",
                  "lpt6",
                  "lpt7",
                  "lpt8",
                  "lpt9"
                ]
              },
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The label of the result a copy was copied from. Null for the review's own files.",
          "title": "Label"
        }
      },
      "required": [
        "path",
        "artifact_id",
        "size",
        "role",
        "schema_version",
        "source",
        "label"
      ],
      "title": "ReviewArtifact",
      "type": "object"
    },
    "ReviewCapabilities": {
      "additionalProperties": false,
      "description": "What the review does and doesn't contain. Each copied run manifest says whether its run\npreserved per-period series.",
      "properties": {
        "return_series": {
          "const": "absent",
          "title": "Return Series",
          "type": "string"
        },
        "statistical_validation": {
          "const": "not_assessed",
          "title": "Statistical Validation",
          "type": "string"
        },
        "trading_readiness": {
          "const": "not_assessed",
          "title": "Trading Readiness",
          "type": "string"
        }
      },
      "required": [
        "return_series",
        "statistical_validation",
        "trading_readiness"
      ],
      "title": "ReviewCapabilities",
      "type": "object"
    },
    "ReviewCommandRecord": {
      "additionalProperties": false,
      "description": "The command that wrote the review, its options, and when it started.",
      "properties": {
        "name": {
          "const": "review",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/ReviewOptions"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "options",
        "started_at"
      ],
      "title": "ReviewCommandRecord",
      "type": "object"
    },
    "ReviewManifestCounts": {
      "additionalProperties": false,
      "description": "The review's counts.",
      "properties": {
        "results": {
          "description": "The results compared, the baseline included.",
          "minimum": 0,
          "title": "Results",
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/SettingRowCounts"
        },
        "metrics": {
          "$ref": "#/$defs/MetricRowCounts"
        }
      },
      "required": [
        "results",
        "settings",
        "metrics"
      ],
      "title": "ReviewManifestCounts",
      "type": "object"
    },
    "ReviewOptions": {
      "additionalProperties": false,
      "description": "The review's options, as given. Neither the configuration's path nor `--out` is\nrecorded, because a path can name the user.",
      "properties": {
        "json": {
          "title": "Json",
          "type": "boolean"
        }
      },
      "required": [
        "json"
      ],
      "title": "ReviewOptions",
      "type": "object"
    },
    "ReviewedResult": {
      "additionalProperties": false,
      "description": "Which run one label names. Each entry agrees with the result's copies.",
      "properties": {
        "label": {
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Label",
          "type": "string"
        },
        "run_manifest": {
          "description": "The `artifact_id` of the run's `manifest.json`, which identifies the run.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Manifest",
          "type": "string"
        },
        "synthetic": {
          "description": "As the run's manifest gives it: true for the run `trialfolio demo` writes.",
          "title": "Synthetic",
          "type": "boolean"
        },
        "plan_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "normalized_tables": {
          "description": "Whether the run has normalized tables. Without them, its settings are compared from its\nplan, and its metrics are unavailable.",
          "title": "Normalized Tables",
          "type": "boolean"
        },
        "response": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `artifact_id` of the run's saved response, `response.json` or `response.raw`; null when\nit has none. Two results with the same one have byte-identical saved responses.",
          "title": "Response"
        }
      },
      "required": [
        "label",
        "run_manifest",
        "synthetic",
        "plan_hash",
        "case_id",
        "normalized_tables",
        "response"
      ],
      "title": "ReviewedResult",
      "type": "object"
    },
    "SettingRowCounts": {
      "additionalProperties": false,
      "description": "`differences.csv`'s setting rows, by classification, and how many are flagged.",
      "properties": {
        "same": {
          "minimum": 0,
          "title": "Same",
          "type": "integer"
        },
        "intended_change": {
          "minimum": 0,
          "title": "Intended Change",
          "type": "integer"
        },
        "unexplained_mismatch": {
          "minimum": 0,
          "title": "Unexplained Mismatch",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "flagged": {
          "minimum": 0,
          "title": "Flagged",
          "type": "integer"
        }
      },
      "required": [
        "same",
        "intended_change",
        "unexplained_mismatch",
        "unknown",
        "flagged"
      ],
      "title": "SettingRowCounts",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "What makes a file a source artifact: when and how it was acquired, and how it's read.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "format": {
          "description": "The source format, such as `screen-configuration` or `p123api-screen-backtest`.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format",
          "type": "string"
        },
        "format_version": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format Version",
          "type": "string"
        },
        "parser_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The version of the adapter that interpreted it; null when nothing interpreted it.",
          "title": "Parser Version"
        },
        "provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "const": "screen_backtest",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The provider operation that produced it; null for a file the user wrote.",
          "title": "Operation"
        }
      },
      "required": [
        "acquired_at",
        "format",
        "format_version",
        "parser_version",
        "provenance",
        "operation"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The manifest of a review written by `trialfolio review`. It has no plan hash, approval,\nparsers, or reproducibility: each copied run manifest records its own.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "review",
      "title": "Artifact Type",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "review_id": {
      "format": "uuid4",
      "title": "Review Id",
      "type": "string"
    },
    "command": {
      "$ref": "#/$defs/ReviewCommandRecord"
    },
    "synthetic": {
      "description": "True when any result is synthetic.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "outcome": {
      "const": "completed",
      "description": "A review writes its manifest only when it completes.",
      "title": "Outcome",
      "type": "string"
    },
    "error": {
      "title": "Error",
      "type": "null"
    },
    "baseline": {
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Baseline",
      "type": "string"
    },
    "results": {
      "description": "One entry for each result, in the configuration's order.",
      "items": {
        "$ref": "#/$defs/ReviewedResult"
      },
      "minItems": 2,
      "title": "Results",
      "type": "array"
    },
    "artifacts": {
      "description": "Each file of the review except its own `manifest.json` and the logs.",
      "items": {
        "$ref": "#/$defs/ReviewArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/Method"
      },
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "license_id": {
      "pattern": "^LicenseRef-[A-Za-z0-9.-]+$",
      "title": "License Id",
      "type": "string"
    },
    "notice_version": {
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Notice Version",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/ReviewCapabilities"
    },
    "counts": {
      "$ref": "#/$defs/ReviewManifestCounts"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "trialfolio_version",
    "created_at",
    "review_id",
    "command",
    "synthetic",
    "outcome",
    "error",
    "baseline",
    "results",
    "artifacts",
    "methods",
    "license_id",
    "notice_version",
    "capabilities",
    "counts"
  ],
  "title": "ReviewManifest",
  "type": "object"
}
