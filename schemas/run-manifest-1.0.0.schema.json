{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.manifest.RunManifest, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "AttemptCounts": {
      "additionalProperties": false,
      "description": "Attempts, by outcome.",
      "properties": {
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "running": {
          "minimum": 0,
          "title": "Running",
          "type": "integer"
        }
      },
      "required": [
        "succeeded",
        "failed",
        "unknown",
        "running"
      ],
      "title": "AttemptCounts",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "description": "What the run does and doesn't contain.",
      "properties": {
        "return_series": {
          "description": "`source_only`: the saved response holds per-period series, which are preserved but not\nnormalized, charted, or analyzed. `absent`: no saved response holds any.",
          "enum": [
            "source_only",
            "absent"
          ],
          "title": "Return Series",
          "type": "string"
        },
        "statistical_validation": {
          "const": "not_assessed",
          "title": "Statistical Validation",
          "type": "string"
        },
        "trading_readiness": {
          "const": "not_assessed",
          "title": "Trading Readiness",
          "type": "string"
        }
      },
      "required": [
        "return_series",
        "statistical_validation",
        "trading_readiness"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "CommandRecord": {
      "additionalProperties": false,
      "description": "The command that wrote the run, its non-secret options, and when it started.",
      "properties": {
        "name": {
          "enum": [
            "run",
            "demo"
          ],
          "title": "Name",
          "type": "string"
        },
        "options": {
          "description": "The command-line options as given, by name, such as `out` and `approve`.",
          "patternProperties": {
            "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Options",
          "type": "object"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "options",
        "started_at"
      ],
      "title": "CommandRecord",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "An error, as a stable code and an actionable message (errors).",
      "properties": {
        "code": {
          "enum": [
            "config.invalid",
            "input.not_found",
            "input.not_a_run",
            "artifact.unknown_schema_version",
            "environment.unsupported",
            "license.not_acknowledged",
            "plan.approval_required",
            "plan.changed",
            "output.not_empty",
            "storage.write_failed",
            "experiment.locked",
            "provider.auth_failed",
            "provider.unavailable",
            "provider.quota_exceeded",
            "provider.unsupported_capability",
            "provider.request_rejected",
            "provider.response_invalid",
            "provider.outcome_unknown",
            "execution.partial",
            "command.interrupted",
            "internal.unexpected"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExternalReference": {
      "additionalProperties": false,
      "description": "A setting that names a mutable object in the provider account.",
      "properties": {
        "setting": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Setting",
          "type": "string"
        },
        "snapshotted": {
          "title": "Snapshotted",
          "type": "boolean"
        }
      },
      "required": [
        "setting",
        "snapshotted"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "ManifestArtifact": {
      "additionalProperties": false,
      "description": "One file of the run, by path, content address, and role.",
      "properties": {
        "path": {
          "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$",
          "title": "Path",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "role": {
          "enum": [
            "plan",
            "configuration",
            "start_record",
            "attempt_record",
            "provider_request",
            "provider_response",
            "provider_response_undecoded",
            "metrics",
            "settings",
            "report"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's schema version, for files that have one, such as the normalized tables.",
          "title": "Schema Version"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "Given exactly for source artifacts."
        }
      },
      "required": [
        "path",
        "artifact_id",
        "size",
        "role",
        "schema_version",
        "source"
      ],
      "title": "ManifestArtifact",
      "type": "object"
    },
    "ManifestCounts": {
      "additionalProperties": false,
      "description": "The run's counts. `quotaRemaining` stays in the attempt record, out of the manifest.",
      "properties": {
        "results": {
          "minimum": 0,
          "title": "Results",
          "type": "integer"
        },
        "cases": {
          "minimum": 0,
          "title": "Cases",
          "type": "integer"
        },
        "attempts": {
          "$ref": "#/$defs/AttemptCounts"
        },
        "provider_requests": {
          "description": "The sends of the planned request that may have reached Portfolio123 (JSON summary).",
          "minimum": 0,
          "title": "Provider Requests",
          "type": "integer"
        },
        "retries": {
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The credits Portfolio123 reported charging; null when it reported none.",
          "title": "Cost"
        }
      },
      "required": [
        "results",
        "cases",
        "attempts",
        "provider_requests",
        "retries",
        "cost"
      ],
      "title": "ManifestCounts",
      "type": "object"
    },
    "ParserVersion": {
      "additionalProperties": false,
      "description": "The parser version applied to one provider response layout.",
      "properties": {
        "layout": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Layout",
          "type": "string"
        },
        "layout_version": {
          "minimum": 1,
          "title": "Layout Version",
          "type": "integer"
        },
        "parser_version": {
          "minimum": 1,
          "title": "Parser Version",
          "type": "integer"
        }
      },
      "required": [
        "layout",
        "layout_version",
        "parser_version"
      ],
      "title": "ParserVersion",
      "type": "object"
    },
    "Reproducibility": {
      "additionalProperties": false,
      "description": "Whether the run's settings fully record what was run. A reference to an account object\nthat wasn't snapshotted makes it incomplete.",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "external_references": {
          "items": {
            "$ref": "#/$defs/ExternalReference"
          },
          "title": "External References",
          "type": "array"
        }
      },
      "required": [
        "status",
        "external_references"
      ],
      "title": "Reproducibility",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "What makes a file a source artifact: when and how it was acquired, and how it's read.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "format": {
          "description": "The source format, such as `screen-configuration` or `p123api-screen-backtest`.",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format",
          "type": "string"
        },
        "format_version": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Format Version",
          "type": "string"
        },
        "parser_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The version of the adapter that interpreted it; null when nothing interpreted it.",
          "title": "Parser Version"
        },
        "provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "const": "screen_backtest",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The provider operation that produced it; null for a file the user wrote.",
          "title": "Operation"
        }
      },
      "required": [
        "acquired_at",
        "format",
        "format_version",
        "parser_version",
        "provenance",
        "operation"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The manifest of a run written by `trialfolio run` or `trialfolio demo`.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "run",
      "title": "Artifact Type",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "command": {
      "$ref": "#/$defs/CommandRecord"
    },
    "synthetic": {
      "description": "True for the synthetic run `trialfolio demo` writes.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "approval": {
      "enum": [
        "interactive",
        "option",
        "not_required"
      ],
      "title": "Approval",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null exactly when the outcome is `completed`. `execution.partial` exactly when it's\n`partial`."
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ManifestArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "parsers": {
      "items": {
        "$ref": "#/$defs/ParserVersion"
      },
      "title": "Parsers",
      "type": "array"
    },
    "license_id": {
      "pattern": "^LicenseRef-[A-Za-z0-9.-]+$",
      "title": "License Id",
      "type": "string"
    },
    "notice_version": {
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Notice Version",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "reproducibility": {
      "$ref": "#/$defs/Reproducibility"
    },
    "counts": {
      "$ref": "#/$defs/ManifestCounts"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "trialfolio_version",
    "created_at",
    "command",
    "synthetic",
    "plan_hash",
    "approval",
    "outcome",
    "error",
    "artifacts",
    "parsers",
    "license_id",
    "notice_version",
    "capabilities",
    "reproducibility",
    "counts"
  ],
  "title": "RunManifest",
  "type": "object"
}
