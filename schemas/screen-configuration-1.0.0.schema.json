{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.screen_configuration.ScreenConfiguration, in validation mode. In serialization mode, the schema differs. Never edit it by hand.",
  "$defs": {
    "FormulaRanking": {
      "additionalProperties": false,
      "description": "A ranking by a single formula, the recommended form.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        },
        "lower_is_better": {
          "title": "Lower Is Better",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "lower_is_better"
      ],
      "title": "FormulaRanking",
      "type": "object"
    },
    "IdRanking": {
      "additionalProperties": false,
      "description": "An existing ranking system in the account, by ID. It's recorded as not snapshotted.",
      "properties": {
        "id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "IdRanking",
      "type": "object"
    },
    "NameRanking": {
      "additionalProperties": false,
      "description": "An existing ranking system in the account, by name. It's recorded as not snapshotted.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "NameRanking",
      "type": "object"
    },
    "Ranking": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormulaRanking"
        },
        {
          "$ref": "#/$defs/NameRanking"
        },
        {
          "$ref": "#/$defs/IdRanking"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "A screen configuration, `kind: screen`: one long-only stock screen backtest, run through\np123api's screen_backtest (docs/contracts.md, screen configuration).",
  "properties": {
    "kind": {
      "const": "screen",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Purpose",
      "type": "string"
    },
    "universe": {
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Universe",
      "type": "string"
    },
    "rules": {
      "items": {
        "minLength": 1,
        "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
        "type": "string"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "ranking": {
      "$ref": "#/$defs/Ranking"
    },
    "max_holdings": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Max Holdings",
      "type": "integer"
    },
    "benchmark": {
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Benchmark",
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "rebalance_weeks": {
      "enum": [
        1,
        4
      ],
      "title": "Rebalance Weeks",
      "type": "integer"
    },
    "transaction_price": {
      "const": "open",
      "title": "Transaction Price",
      "type": "string"
    },
    "slippage_percent": {
      "description": "Plain notation, with at most 4 digits after the decimal point and 15 significant digits. Never a string.",
      "exclusiveMaximum": 10000000000000000,
      "minimum": 0,
      "title": "Slippage Percent",
      "type": "number"
    },
    "pit_method": {
      "const": "complete",
      "title": "Pit Method",
      "type": "string"
    },
    "precision": {
      "const": 4,
      "title": "Precision",
      "type": "integer"
    },
    "data_vendor": {
      "const": "FactSet",
      "title": "Data Vendor",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "title",
    "universe",
    "rules",
    "ranking",
    "max_holdings",
    "benchmark",
    "start_date",
    "end_date",
    "rebalance_weeks",
    "transaction_price",
    "slippage_percent",
    "pit_method",
    "precision"
  ],
  "title": "ScreenConfiguration",
  "type": "object"
}
