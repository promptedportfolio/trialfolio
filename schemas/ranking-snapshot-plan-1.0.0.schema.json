{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.ranking_snapshot.RankingSnapshotPlan, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "The request budget (budget and retries).",
      "properties": {
        "provider_requests": {
          "const": 1,
          "description": "A 1.0.0 plan has one request, sent at most once.",
          "title": "Provider Requests",
          "type": "integer"
        },
        "credits_per_request": {
          "description": "Portfolio123's documented cost of one request when the plan was made. It isn't fixed,\nbecause Portfolio123 can change it.",
          "minimum": 0,
          "title": "Credits Per Request",
          "type": "integer"
        },
        "credits_per_request_source": {
          "$ref": "#/$defs/DocumentedSource"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "integer"
        },
        "authentication_calls": {
          "const": 1,
          "title": "Authentication Calls",
          "type": "integer"
        }
      },
      "required": [
        "provider_requests",
        "credits_per_request",
        "credits_per_request_source",
        "credits",
        "authentication_calls"
      ],
      "title": "Budget",
      "type": "object"
    },
    "DocumentedSource": {
      "additionalProperties": false,
      "description": "Where a documented value comes from, and the date the documentation was checked.",
      "properties": {
        "title": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "checked"
      ],
      "title": "DocumentedSource",
      "type": "object"
    },
    "RankGetParams": {
      "additionalProperties": false,
      "description": "The params p123api's `rank_get` sends as the query of `GET /rank`: the system's name.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RankGetParams",
      "type": "object"
    },
    "RankGetRequest": {
      "additionalProperties": false,
      "description": "A snapshot's one request, the `rank_get` that reads the system it names.",
      "properties": {
        "operation": {
          "const": "rank_get",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RankGetParams"
        }
      },
      "required": [
        "operation",
        "params"
      ],
      "title": "RankGetRequest",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "The retry policy: no automatic retries, and one exchange per wrapper call.",
      "properties": {
        "automatic_retries": {
          "const": 0,
          "title": "Automatic Retries",
          "type": "integer"
        },
        "wrapper_attempts_per_call": {
          "const": 1,
          "title": "Wrapper Attempts Per Call",
          "type": "integer"
        },
        "exchanges_per_call": {
          "const": 1,
          "title": "Exchanges Per Call",
          "type": "integer"
        }
      },
      "required": [
        "automatic_retries",
        "wrapper_attempts_per_call",
        "exchanges_per_call"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "SnapshotDataSent": {
      "additionalProperties": false,
      "description": "A category of data a snapshot's request sends: the credentials, and the system's name, as\n`strategy_definition`. It sends no backtest settings.",
      "properties": {
        "category": {
          "enum": [
            "credentials",
            "strategy_definition",
            "backtest_settings"
          ],
          "title": "Category",
          "type": "string"
        },
        "recipient": {
          "const": "Portfolio123",
          "title": "Recipient",
          "type": "string"
        },
        "via": {
          "const": "p123api",
          "title": "Via",
          "type": "string"
        },
        "settings": {
          "items": {
            "const": "system",
            "type": "string"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "recipient",
        "via",
        "settings"
      ],
      "title": "SnapshotDataSent",
      "type": "object"
    },
    "TransportVersions": {
      "additionalProperties": false,
      "description": "The installed `requests` and `urllib3`, which carry the wrapper's requests.",
      "properties": {
        "requests": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Requests",
          "type": "string"
        },
        "urllib3": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Urllib3",
          "type": "string"
        }
      },
      "required": [
        "requests",
        "urllib3"
      ],
      "title": "TransportVersions",
      "type": "object"
    },
    "WrapperVersions": {
      "additionalProperties": false,
      "description": "The installed `p123api`, which sends the requests (plan contents).",
      "properties": {
        "p123api": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "P123Api",
          "type": "string"
        }
      },
      "required": [
        "p123api"
      ],
      "title": "WrapperVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A ranking snapshot's plan: the system its configuration names, its one `rank_get`, the\nbudget, the retry policy, and the data sent. It has no title, purpose, or cases. Execution\nrequires its `plan_hash` as approval (ranking snapshot output).",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "canonicalization_version": {
      "const": 1,
      "title": "Canonicalization Version",
      "type": "integer"
    },
    "provider_wrapper": {
      "$ref": "#/$defs/WrapperVersions"
    },
    "transport": {
      "$ref": "#/$defs/TransportVersions"
    },
    "system": {
      "description": "The configuration's `system`, which is sent.",
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "System",
      "type": "string"
    },
    "requests": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/RankGetRequest"
        }
      ],
      "title": "Requests",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget",
      "description": "One provider request, at 1 credit, `rank_get`'s documented cost, and one authentication\ncall."
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "data_sent": {
      "description": "`credentials`, then `strategy_definition`, which carries `system`.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/SnapshotDataSent"
        },
        {
          "$ref": "#/$defs/SnapshotDataSent"
        }
      ],
      "title": "Data Sent",
      "type": "array"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trialfolio_version",
    "canonicalization_version",
    "provider_wrapper",
    "transport",
    "system",
    "requests",
    "budget",
    "retry_policy",
    "data_sent",
    "plan_hash"
  ],
  "title": "RankingSnapshotPlan",
  "type": "object"
}
