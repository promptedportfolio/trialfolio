{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.plan.Plan, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "The request budget (budget and retries).",
      "properties": {
        "provider_requests": {
          "const": 1,
          "description": "A 1.0.0 plan has one request, sent at most once.",
          "title": "Provider Requests",
          "type": "integer"
        },
        "credits_per_request": {
          "description": "Portfolio123's documented cost of one request when the plan was made. It isn't fixed,\nbecause Portfolio123 can change it.",
          "minimum": 0,
          "title": "Credits Per Request",
          "type": "integer"
        },
        "credits_per_request_source": {
          "$ref": "#/$defs/DocumentedSource"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "integer"
        },
        "authentication_calls": {
          "const": 1,
          "title": "Authentication Calls",
          "type": "integer"
        }
      },
      "required": [
        "provider_requests",
        "credits_per_request",
        "credits_per_request_source",
        "credits",
        "authentication_calls"
      ],
      "title": "Budget",
      "type": "object"
    },
    "DataSent": {
      "additionalProperties": false,
      "description": "A category of data that leaves the machine, its recipient, and the settings it carries.",
      "properties": {
        "category": {
          "enum": [
            "credentials",
            "strategy_definition",
            "backtest_settings"
          ],
          "title": "Category",
          "type": "string"
        },
        "recipient": {
          "const": "Portfolio123",
          "title": "Recipient",
          "type": "string"
        },
        "via": {
          "const": "p123api",
          "title": "Via",
          "type": "string"
        },
        "settings": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "recipient",
        "via",
        "settings"
      ],
      "title": "DataSent",
      "type": "object"
    },
    "DocumentedSource": {
      "additionalProperties": false,
      "description": "Where a documented value comes from, and the date the documentation was checked.",
      "properties": {
        "title": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "checked"
      ],
      "title": "DocumentedSource",
      "type": "object"
    },
    "FormulaRanking": {
      "additionalProperties": false,
      "description": "A ranking by a single formula, the recommended form.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        },
        "lower_is_better": {
          "title": "Lower Is Better",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "lower_is_better"
      ],
      "title": "FormulaRanking",
      "type": "object"
    },
    "FormulaRankingParams": {
      "additionalProperties": false,
      "description": "A single-formula ranking, as sent.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        },
        "lowerIsBetter": {
          "title": "Lowerisbetter",
          "type": "boolean"
        }
      },
      "required": [
        "formula",
        "lowerIsBetter"
      ],
      "title": "FormulaRankingParams",
      "type": "object"
    },
    "IdRanking": {
      "additionalProperties": false,
      "description": "An existing ranking system in the account, by ID. It's recorded as not snapshotted.",
      "properties": {
        "id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "IdRanking",
      "type": "object"
    },
    "NameRanking": {
      "additionalProperties": false,
      "description": "An existing ranking system in the account, by name. It's recorded as not snapshotted.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "NameRanking",
      "type": "object"
    },
    "PlanCase": {
      "additionalProperties": false,
      "description": "One fully resolved case. A 1.0.0 plan has exactly one.",
      "properties": {
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "requests": {
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/PlanRequest"
            }
          ],
          "title": "Requests",
          "type": "array"
        },
        "settings": {
          "items": {
            "$ref": "#/$defs/PlanSetting"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "requests",
        "settings"
      ],
      "title": "PlanCase",
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "description": "One provider request a case needs.",
      "properties": {
        "operation": {
          "const": "screen_backtest",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ScreenBacktestParams"
        }
      },
      "required": [
        "operation",
        "params"
      ],
      "title": "PlanRequest",
      "type": "object"
    },
    "PlanSetting": {
      "additionalProperties": false,
      "description": "One resolved setting: a `settings.csv` row without `label`, `original_key`,\n`original_value`, and `source_artifact`, with `expected_provenance` for `provenance`.",
      "properties": {
        "setting": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Setting",
          "type": "string"
        },
        "category": {
          "enum": [
            "dates",
            "benchmark",
            "currency",
            "costs",
            "execution",
            "universe",
            "data_source",
            "strategy",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/SettingValue"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "count",
                "weeks",
                "percent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "interpretation": {
          "enum": [
            "interpreted",
            "not_interpreted"
          ],
          "title": "Interpretation",
          "type": "string"
        },
        "expected_provenance": {
          "enum": [
            "verified",
            "user_supplied",
            "inferred",
            "unknown"
          ],
          "title": "Expected Provenance",
          "type": "string"
        },
        "inference_rule": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inference Rule"
        },
        "flags": {
          "items": {
            "enum": [
              "inferred_default",
              "not_snapshotted"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "setting",
        "category",
        "critical",
        "value",
        "unit",
        "interpretation",
        "expected_provenance",
        "inference_rule",
        "flags"
      ],
      "title": "PlanSetting",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "The retry policy: no automatic retries, and one exchange per wrapper call.",
      "properties": {
        "automatic_retries": {
          "const": 0,
          "title": "Automatic Retries",
          "type": "integer"
        },
        "wrapper_attempts_per_call": {
          "const": 1,
          "title": "Wrapper Attempts Per Call",
          "type": "integer"
        },
        "exchanges_per_call": {
          "const": 1,
          "title": "Exchanges Per Call",
          "type": "integer"
        }
      },
      "required": [
        "automatic_retries",
        "wrapper_attempts_per_call",
        "exchanges_per_call"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "ScreenBacktestParams": {
      "additionalProperties": false,
      "description": "The JSON object passed to p123api's `screen_backtest`, exactly as it will be sent.\n\n`slippage` is always a JSON float, and every other number an integer (plan contents).",
      "properties": {
        "screen": {
          "$ref": "#/$defs/ScreenParams"
        },
        "startDt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Startdt",
          "type": "string"
        },
        "endDt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Enddt",
          "type": "string"
        },
        "pitMethod": {
          "const": "Complete",
          "title": "Pitmethod",
          "type": "string"
        },
        "precision": {
          "const": 4,
          "title": "Precision",
          "type": "integer"
        },
        "transPrice": {
          "const": 1,
          "title": "Transprice",
          "type": "integer"
        },
        "slippage": {
          "title": "Slippage",
          "type": "number"
        },
        "rebalFreq": {
          "enum": [
            "Every Week",
            "Every 4 Weeks"
          ],
          "title": "Rebalfreq",
          "type": "string"
        }
      },
      "required": [
        "screen",
        "startDt",
        "endDt",
        "pitMethod",
        "precision",
        "transPrice",
        "slippage",
        "rebalFreq"
      ],
      "title": "ScreenBacktestParams",
      "type": "object"
    },
    "ScreenParams": {
      "additionalProperties": false,
      "description": "The `screen` object of a screen backtest request.",
      "properties": {
        "type": {
          "const": "stock",
          "title": "Type",
          "type": "string"
        },
        "universe": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Universe",
          "type": "string"
        },
        "maxNumHoldings": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Maxnumholdings",
          "type": "integer"
        },
        "method": {
          "const": "long",
          "title": "Method",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "benchmark": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Benchmark",
          "type": "string"
        },
        "ranking": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaRankingParams"
            },
            {
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
              "type": "string"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "title": "Ranking"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ScreenRuleParams"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "type",
        "universe",
        "maxNumHoldings",
        "method",
        "currency",
        "benchmark",
        "ranking",
        "rules"
      ],
      "title": "ScreenParams",
      "type": "object"
    },
    "ScreenRuleParams": {
      "additionalProperties": false,
      "description": "One screening rule, as sent. It has no `type` field: Portfolio123 rejects one.",
      "properties": {
        "formula": {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Formula",
          "type": "string"
        }
      },
      "required": [
        "formula"
      ],
      "title": "ScreenRuleParams",
      "type": "object"
    },
    "SettingValue": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "items": {
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/FormulaRanking"
        },
        {
          "$ref": "#/$defs/NameRanking"
        },
        {
          "$ref": "#/$defs/IdRanking"
        }
      ]
    },
    "TransportVersions": {
      "additionalProperties": false,
      "description": "The installed `requests` and `urllib3`, which carry the wrapper's requests.",
      "properties": {
        "requests": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Requests",
          "type": "string"
        },
        "urllib3": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "Urllib3",
          "type": "string"
        }
      },
      "required": [
        "requests",
        "urllib3"
      ],
      "title": "TransportVersions",
      "type": "object"
    },
    "WrapperVersions": {
      "additionalProperties": false,
      "description": "The installed `p123api`, which sends the requests (plan contents).",
      "properties": {
        "p123api": {
          "pattern": "^[0-9][0-9A-Za-z.+!_-]*$",
          "title": "P123Api",
          "type": "string"
        }
      },
      "required": [
        "p123api"
      ],
      "title": "WrapperVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A plan: every resolved case, its requests, the budget, the retry policy, and the data\nsent. Execution requires its `plan_hash` as approval (plans and approval).",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trialfolio_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Trialfolio Version",
      "type": "string"
    },
    "canonicalization_version": {
      "const": 1,
      "title": "Canonicalization Version",
      "type": "integer"
    },
    "provider_wrapper": {
      "$ref": "#/$defs/WrapperVersions"
    },
    "transport": {
      "$ref": "#/$defs/TransportVersions"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Purpose"
    },
    "cases": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/PlanCase"
        }
      ],
      "title": "Cases",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "data_sent": {
      "items": {
        "$ref": "#/$defs/DataSent"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Data Sent",
      "type": "array"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trialfolio_version",
    "canonicalization_version",
    "provider_wrapper",
    "transport",
    "title",
    "purpose",
    "cases",
    "budget",
    "retry_policy",
    "data_sent",
    "plan_hash"
  ],
  "title": "Plan",
  "type": "object"
}
