{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.tables.DifferencesRow, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "additionalProperties": false,
  "description": "One row of `differences.csv`: one setting or one metric of one result, compared with the\nbaseline's (docs/contracts.md, differences between screen runs).",
  "properties": {
    "label": {
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Label",
      "type": "string"
    },
    "baseline_label": {
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      },
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Baseline Label",
      "type": "string"
    },
    "kind": {
      "enum": [
        "setting",
        "metric"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "description": "The setting, or the `metric_id`.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "enum": [
            "strategy",
            "benchmark"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For metrics. Null for settings.",
      "title": "Subject"
    },
    "category": {
      "anyOf": [
        {
          "enum": [
            "dates",
            "benchmark",
            "currency",
            "costs",
            "execution",
            "universe",
            "data_source",
            "strategy",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For settings, as in `settings.csv`. Null for metrics.",
      "title": "Category"
    },
    "critical": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "description": "For settings, as in `settings.csv`. Null for metrics.",
      "title": "Critical"
    },
    "baseline_value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Value"
    },
    "value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The two values compared, as their tables write them. Null when unavailable.",
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "pattern": "^(percent|ratio|count|days|date|currency:[A-Z]{3})$",
          "type": "string"
        },
        {
          "enum": [
            "count",
            "weeks",
            "percent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "classification": {
      "anyOf": [
        {
          "enum": [
            "same",
            "intended_change",
            "unexplained_mismatch",
            "unknown"
          ],
          "type": "string"
        },
        {
          "enum": [
            "differenced",
            "not_comparable",
            "unavailable"
          ],
          "type": "string"
        }
      ],
      "title": "Classification"
    },
    "difference": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For `differenced` metrics, `value - baseline_value`, with exactly `difference_decimals`\ndigits after the decimal point, and never a signed zero. Null otherwise.",
      "title": "Difference"
    },
    "difference_unit": {
      "anyOf": [
        {
          "pattern": "^(pp|ratio|count|days|currency:[A-Z]{3})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Difference Unit"
    },
    "difference_decimals": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Difference Decimals"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "different_benchmark",
            "different_period",
            "unknown_period",
            "different_unit",
            "input_unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For `not_comparable` and `unavailable` metrics. Null otherwise.",
      "title": "Reason"
    },
    "declared_reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For a setting declared as an intended change, its reason, whatever the classification.\nOnly a declarable setting has one.",
      "title": "Declared Reason"
    },
    "flagged": {
      "description": "True exactly when a flag in `FLAGGING` applies.",
      "title": "Flagged",
      "type": "boolean"
    },
    "flags": {
      "items": {
        "enum": [
          "critical_unexplained_mismatch",
          "critical_unknown",
          "intended_change_not_observed",
          "inferred_default",
          "time_dependent_default",
          "unsupported_value",
          "not_snapshotted",
          "coverage_mismatch",
          "identical_source"
        ],
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    }
  },
  "required": [
    "label",
    "baseline_label",
    "kind",
    "name",
    "subject",
    "category",
    "critical",
    "baseline_value",
    "value",
    "unit",
    "classification",
    "difference",
    "difference_unit",
    "difference_decimals",
    "reason",
    "declared_reason",
    "flagged",
    "flags"
  ],
  "title": "DifferencesRow",
  "type": "object"
}
