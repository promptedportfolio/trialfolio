{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/schemas from trialfolio.contracts.tables.ComparisonRow, in serialization mode. Validation and serialization modes give the same schema. Never edit it by hand.",
  "additionalProperties": false,
  "description": "One row of `comparison.csv`: one metric or one analysis value of a case, compared with the\nbaseline's, by `baseline-comparison` version 1 (comparing a case with the baseline,\ncomparison.csv).",
  "properties": {
    "label": {
      "description": "The compared case's `case_id`, as its tables label its rows.",
      "pattern": "^case-[0-9a-f]{16}$",
      "title": "Label",
      "type": "string"
    },
    "baseline_label": {
      "description": "The baseline's `case_id`.",
      "pattern": "^case-[0-9a-f]{16}$",
      "title": "Baseline Label",
      "type": "string"
    },
    "kind": {
      "description": "A row of `metrics.csv`, or of `analysis.csv`.",
      "enum": [
        "metric",
        "analysis"
      ],
      "title": "Kind",
      "type": "string"
    },
    "segment": {
      "anyOf": [
        {
          "pattern": "^(full|split-([0-9]|10))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "An analysis row's `segment`. Null on a metric row.",
      "title": "Segment"
    },
    "name": {
      "description": "The metric's `metric_id`, or the analysis row's `analysis`.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "enum": [
            "strategy",
            "benchmark",
            "excess"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The two rows' `subject`. Null where `analysis.csv`'s is.",
      "title": "Subject"
    },
    "window_days": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "An analysis row's `window_days`. Null otherwise.",
      "title": "Window Days"
    },
    "baseline_value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Value"
    },
    "value": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The baseline's and the case's values, as their tables write them. Null when unavailable.",
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "pattern": "^(percent|ratio|count|days|date|currency:[A-Z]{3})$",
          "type": "string"
        },
        {
          "enum": [
            "percent",
            "pp",
            "ratio",
            "count",
            "days",
            "date"
          ],
          "type": "string"
        }
      ],
      "description": "The two rows' unit.",
      "title": "Unit"
    },
    "classification": {
      "enum": [
        "differenced",
        "not_comparable",
        "unavailable"
      ],
      "title": "Classification",
      "type": "string"
    },
    "difference": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For `differenced`, `value - baseline_value`, with exactly `difference_decimals` digits\nafter its point, and without a sign when it's zero. Null otherwise.",
      "title": "Difference"
    },
    "difference_unit": {
      "anyOf": [
        {
          "pattern": "^(pp|ratio|count|days|currency:[A-Z]{3})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Difference Unit"
    },
    "difference_decimals": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Difference Decimals"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "input_unavailable",
            "different_unit",
            "different_benchmark",
            "different_period",
            "unknown_period",
            "different_rebalance"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "For `not_comparable` and `unavailable`, the first reason that applies. Null otherwise.",
      "title": "Reason"
    }
  },
  "required": [
    "label",
    "baseline_label",
    "kind",
    "segment",
    "name",
    "subject",
    "window_days",
    "baseline_value",
    "value",
    "unit",
    "classification",
    "difference",
    "difference_unit",
    "difference_decimals",
    "reason"
  ],
  "title": "ComparisonRow",
  "type": "object"
}
