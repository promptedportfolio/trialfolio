#!/bin/sh
# Writes the JSON Schemas under schemas/ from the contract models. With --check, writes nothing,
# and fails if a committed schema differs, is missing, or is extra: the schema drift check,
# which scripts/check runs (docs/contracts.md, schema generation and drift). This is the only way
# the schemas are written; never edit them by hand.
set -eu
root=$(git rev-parse --show-toplevel)
exec uv run --project "$root" python -m trialfolio.contracts.schema_files --dir "$root/schemas" "$@"
