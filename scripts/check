#!/bin/sh
# Runs every check that needs no credentials or reference data, in order, and stops at the
# first failure (release 0.1.0, verification commands). The pre-push hook runs it.
# The reference and live tests aren't run here: they need the owner's local data, or the
# owner's credentials and presence.
set -eu
cd "$(git rev-parse --show-toplevel)"

step() {
  printf '\n== %s\n' "$1"
}

command -v uv >/dev/null 2>&1 || {
  echo "check: uv not found. Install it (https://docs.astral.sh/uv/)." >&2
  exit 1
}

# Without the hooks, nothing runs these checks before a push. A CI job runs the checks
# itself and pushes nothing.
if [ -z "${CI:-}" ] && [ "$(git config core.hooksPath)" != .githooks ]; then
  echo "check: the Git hooks are off. Run scripts/setup (AGENTS.md)." >&2
  exit 1
fi

step "Lock file matches pyproject.toml"
uv lock --check

step "Format"
uv run ruff format --check .

step "Lint"
uv run ruff check .

step "Types"
# Without this, the pyright wrapper asks PyPI for its latest version on every run.
PYRIGHT_PYTHON_IGNORE_WARNINGS=1 uv run pyright

step "Schemas"
scripts/schemas --check
# The check reads the working tree, and the pre-push hook refuses only uncommitted changes to
# tracked files. A generated schema that was never added would pass here, and not be pushed.
# Ignored files count too. The drift check skips hidden entries and lists any other file as
# extra, so only the schema files themselves need checking here.
untracked=$(git ls-files --others -- ':(glob)schemas/[!.]*.schema.json')
if [ -n "$untracked" ]; then
  printf 'check: schemas not added to git:\n%s\nAdd and commit them.\n' "$untracked" >&2
  exit 1
fi

# A pytest step that collects no tests fails too (exit 5), so a missing test can't pass.
step "Tests"
uv run pytest

step "Packaging tests"
uv run pytest -m packaging

printf '\nAll checks passed.\n'
